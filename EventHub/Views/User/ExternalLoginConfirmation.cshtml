@model ExternalLoginConfirmationViewModel
@inject IStringLocalizer<AuthResource> AuthLocalizer

@{
    ViewData["Title"] = AuthLocalizer["Auth.External.ConfirmationTitle"];
    Layout = null;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
}

<link rel="stylesheet" href="~/css/loginRegisterPage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@AuthLocalizer["Auth.External.ConfirmationTitle"]</title>
</head>
<body class="bg-light">
    <div class="form-wrapper">
        <div class="form-box">
            <h3 class="heading">EventHub</h3>
            <div class="text-center mb-3">
                @await Html.PartialAsync("~/Views/Shared/_CultureSelector.cshtml")
            </div>
            <p class="text-center text-muted mb-4">@AuthLocalizer["Auth.External.ConfirmationSubtitle"]</p>

            <form asp-action="ExternalLoginConfirmation" asp-route-returnUrl="@returnUrl" method="post" class="form">
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <input asp-for="Provider" type="hidden" />

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.Email"]</label>
                    <input value="@Model.Email" type="email" class="input" disabled>
                </div>

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.Username"]</label>
                    <input asp-for="UserName" type="text" class="input" autocomplete="username">
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="custom-validation-summary"></div>
                <button type="submit" class="form-button">@AuthLocalizer["Auth.External.ConfirmationSubmit"]</button>
            </form>

            <p class="text-center mt-3 mb-0 small">
                <a href="/User/Login">@AuthLocalizer["Auth.External.BackToLogin"]</a>
            </p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
