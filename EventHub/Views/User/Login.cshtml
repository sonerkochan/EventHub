@model LoginViewModel
@{
    ViewData["Title"] = "EventHub | Login";
    Layout = null;
}

<link rel = "stylesheet" href="~/css/loginRegisterPage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/forms.css" asd-append-version="true" />


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub | Login</title>
    
</head>


<body class="bg-light">
    <div class="form-wrapper">
        <div class="form-box">
            <h3 class="heading">EventHub</h3>
            <p class="text-center text-muted mb-4">Sign in to your account</p>
            <form asp-action="Login" method="post" class="form">

                <div class="input-group">
                    <label class="form-label">Username</label>
                    <input asp-for="Username" type="text" class="input" autocomplete="username">
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="input" autocomplete="current-password">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="input-group checkbox-row">
                    <input type="checkbox" class="input-checkbox" id="remember">
                    <label class="form-label" for="remember">Remember me</label>
                </div>

                <button type="submit" class="form-button">Log in</button>
            </form>

            <p class="text-center mt-3 mb-0 small">
                Don't have an account? <a href="/User/Register">Sign up</a>
            </p>
        </div>
    </div>
</body>
</html>