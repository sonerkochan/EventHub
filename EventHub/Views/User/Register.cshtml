@using EzyShape.Core.Models.User
@model ClientRegisterViewModel
@{
    ViewData["Title"] = "EventHub | Register";
    Layout = null;
}
<link rel="stylesheet" href="~/css/loginRegisterPage.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/forms.css" asd-append-version="true" />

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventHub | Register</title>
        @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" *@
</head>
<body class="bg-light">
    <div class="form-wrapper">
        <div class="form-box" >
            <h3 class="heading">EventHub</h3>
            <p class="text-center text-muted mb-4">Create your account</p>

            <form asp-action="Register" method="post" class="form">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="input-group">
                    <label class="form-label">Username</label>
                    <input asp-for="UserName" type="text" class="input" autocomplete="username">
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="input" autocomplete="email">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="input" autocomplete="new-password">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="form-button">Register</button>
            </form>

            <p class="text-center mt-3 mb-0 small">
                Already have an account? <a href="/User/Login">Sign in</a>
            </p>
        </div>
    </div>
</body>
</html>