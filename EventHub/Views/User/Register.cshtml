@using EzyShape.Core.Models.User
@model ClientRegisterViewModel
@inject IStringLocalizer<AuthResource> AuthLocalizer

@{
    ViewData["Title"] = AuthLocalizer["Auth.Register.Title"];
    Layout = null;
}

<link rel="stylesheet" href="~/css/loginRegisterPage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@AuthLocalizer["Auth.Register.Title"]</title>
</head>
<body class="bg-light">
    <div class="form-wrapper">
        <div class="form-box">
            <h3 class="heading">EventHub</h3>
            <div class="text-center mb-3">
                @await Html.PartialAsync("~/Views/Shared/_CultureSelector.cshtml")
            </div>
            <p class="text-center text-muted mb-4">@AuthLocalizer["Auth.Register.Subtitle"]</p>

            <form asp-action="Register" method="post" class="form">
                @Html.AntiForgeryToken()

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.Username"]</label>
                    <input asp-for="UserName" type="text" class="input" autocomplete="username">
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.Email"]</label>
                    <input asp-for="Email" type="email" class="input" autocomplete="email">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.Password"]</label>
                    <input asp-for="Password" type="password" class="input" autocomplete="new-password">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="input-group">
                    <label class="form-label">@AuthLocalizer["Auth.Field.ConfirmPassword"]</label>
                    <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="form-button">@AuthLocalizer["Auth.Register.Submit"]</button>
            </form>

            <p class="text-center mt-3 mb-0 small">
                @AuthLocalizer["Auth.Register.HasAccount"] <a href="/User/Login">@AuthLocalizer["Auth.Register.SignIn"]</a>
            </p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.13/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
