@using EventHub.Infrastructure.Data.Models
@model List<Venue>

<h1>Venues</h1>
<a asp-action="Create">New Venue</a>

<table>
    @foreach (var venue in Model)
    {
        <tr>
            <td>@venue.Name</td>
            <td>
                <a asp-action="Edit" asp-route-id="@venue.Id">Edit</a>
                <a asp-action="Delete" asp-route-id="@venue.Id">Delete</a>
            </td>
        </tr>
    }
</table>