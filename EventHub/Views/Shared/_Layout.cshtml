@using EventHub.Infrastructure.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - EventHub</title>

    <link href="https://fonts.googleapis.com/css?family=Poppins:100,200,300,400,500,600,700" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/travelista/css/linearicons.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/animate.min.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/nice-select.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/owl.carousel.css" />
    <link rel="stylesheet" href="~/lib/travelista/css/main.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ── Shared brand tokens ── */
        :root {
            --tr-dark:    #1a1a2e;
            --tr-mid:     #0f3460;
            --tr-accent:  #55a5d2;
            --tr-light:   #f4f7fa;
            --tr-border:  #e8ecf0;
            --tr-text:    #555;
            --tr-muted:   #999;
        }

        body { font-family: 'Poppins', sans-serif; background: #f9fafb; color: var(--tr-text); }

        /* ── Navbar ── */
        .eh-navbar {
            background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1030;
            min-height: 70px;
        }
        .eh-navbar .navbar-brand {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.35rem;
            color: var(--tr-dark);
            letter-spacing: -0.5px;
        }
        .eh-navbar .navbar-brand span { color: var(--tr-accent); }
        .eh-navbar .navbar-brand small {
            font-size: 0.55rem; font-weight: 400;
            color: var(--tr-muted); vertical-align: middle; margin-left: 4px;
        }
        .eh-nav-link {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--tr-text) !important;
            padding: 0.5rem 1rem !important;
            margin: 0.65rem 0.2rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 1;
        }
        .eh-nav-link i {
            font-size: 1.25em;
            line-height: 1;
            transition: all 0.3s ease;
        }
        .eh-nav-link:hover { 
            color: var(--tr-accent) !important; 
            background: rgba(0,0,0,0.04);
        }
        .eh-nav-link.active { 
            color: #fff !important; 
            background: var(--tr-accent);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        /* ── Hamburger fix (travelista strips Bootstrap's built-in SVG) ── */
        .navbar-toggler {
            border: 1px solid rgba(0,0,0,0.15);
            padding: 0.4rem 0.6rem;
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(0,0,0,0.5)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            width: 1.5em;
            height: 1.5em;
            background-size: contain;
            display: inline-block;
        }

        /* user avatar */
        .eh-user-avatar {
            width: 34px; height: 34px;
            background: var(--tr-accent);
            color: #fff;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
        }
        .eh-dropdown-menu {
            border: none;
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
            border-radius: 6px;
            font-size: 0.85rem;
            min-width: 210px;
        }
        .eh-dropdown-menu .dropdown-item { padding: 0.6rem 1.2rem; color: #555; }
        .eh-dropdown-menu .dropdown-item:hover { background: #f0f8ff; color: var(--tr-accent); }
        .eh-dropdown-menu .dropdown-item.text-danger:hover { background: #fff5f5; color: #dc3545; }

        /* auth buttons */
        .eh-nav-btn {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 20px;
            border-radius: 4px;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
            display: inline-block;
        }
        .eh-nav-btn-outline {
            border: 1px solid var(--tr-border);
            color: var(--tr-text);
            background: transparent;
        }
        .eh-nav-btn-outline:hover { border-color: var(--tr-accent); color: var(--tr-accent); text-decoration: none; }
        .eh-nav-btn-primary {
            background: var(--tr-accent);
            color: #fff;
            border: 1px solid var(--tr-accent);
        }
        .eh-nav-btn-primary:hover { background: var(--tr-dark); border-color: var(--tr-dark); color: #fff; text-decoration: none; }

        /* on mobile, give auth buttons a little breathing room */
        @@media (max-width: 991px) {
            .eh-nav-btn { display: block; margin: 4px 0; text-align: center; }
        }

        /* ── Footer ── */
        .eh-footer {
            background: var(--tr-dark);
            padding: 48px 0 24px;
            margin-top: 72px;
        }
        .eh-footer-brand { font-weight: 700; font-size: 1.2rem; color: #fff; margin-bottom: 8px; }
        .eh-footer-brand span { color: var(--tr-accent); }
        .eh-footer p { color: rgba(255,255,255,0.45); font-size: 0.8rem; margin: 0; }
        .eh-footer-link { color: rgba(255,255,255,0.5); font-size: 0.8rem; text-decoration: none; margin-left: 18px; transition: color 0.2s; }
        .eh-footer-link:hover { color: var(--tr-accent); text-decoration: none; }
        .eh-footer-divider { border-color: rgba(255,255,255,0.08); margin: 28px 0 20px; }

        /* ── Shared utilities ── */
        .primary-btn { background: var(--tr-accent); color: #fff; font-weight: 600; letter-spacing: 0.3px; transition: background 0.2s; }
        .primary-btn:hover { background: var(--tr-dark); color: #fff; }
        .card { border-radius: 8px; border: 1px solid var(--tr-border); }
        .card-header { font-weight: 600; }

        /* Bootstrap badge tweaks */
        .badge-primary   { background: #e8f4fd !important; color: #2196f3 !important; }
        .badge-warning   { background: #fff8e1 !important; color: #ff9800 !important; }
        .badge-success   { background: #e8f8f0 !important; color: #27ae60 !important; }
        .badge-danger    { background: #fce8e8 !important; color: #e74c3c !important; }
        .badge-info      { background: #e8f0ff !important; color: #5c6bc0 !important; }
        .badge-secondary { background: #f1f3f4 !important; color: #777 !important; }
    </style>
</head>
<body>

<!-- ===== NAVBAR ===== -->
<!-- FIX 1: added navbar-light so Bootstrap knows to render a dark hamburger on white bg -->
<nav class="navbar navbar-expand-lg navbar-light eh-navbar">
    <div class="container">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            Event<span>Hub</span>
        </a>

        <!-- FIX 2: hamburger SVG now rendered via CSS above; aria attrs added for a11y -->
        <button class="navbar-toggler" type="button" data-toggle="collapse"
                data-target="#mainNav" aria-controls="mainNav"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- FIX 3: auth section moved INSIDE the collapse so it hides/shows with the menu on mobile -->
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav mx-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link eh-nav-link">
                            <i class="fa fa-home"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Client" asp-controller="Events" asp-action="Index" class="nav-link eh-nav-link">
                            <i class="fa fa-calendar"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Client" asp-controller="Tickets" asp-action="Index" class="nav-link eh-nav-link">
                            <i class="fa fa-ticket"></i> My Tickets
                        </a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item mr-lg-2 my-2 my-lg-0">
                    @await Html.PartialAsync("~/Views/Shared/_CurrencySelector.cshtml")
                </li>
                @if (!SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a asp-controller="User" asp-action="Login" class="eh-nav-btn eh-nav-btn-outline">Login</a>
                    </li>
                    <li class="nav-item ml-lg-2">
                        <a asp-controller="User" asp-action="Register" class="eh-nav-btn eh-nav-btn-primary">Sign Up</a>
                    </li>
                }
                else
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex align-items-center" data-toggle="dropdown">
                            <span class="eh-user-avatar">@GetInitial(User.Identity?.Name)</span>
                            <span class="ml-2 d-none d-lg-inline" style="font-size:0.82rem;font-weight:500;color:#555;">
                                @User.Identity?.Name
                            </span>
                            <i class="fa fa-angle-down ml-1" style="font-size:0.75rem;color:#bbb;"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right eh-dropdown-menu">
                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Client"))
                            {
                                <a asp-area="Client" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                <i class="fa fa-th-large mr-2"></i> Client Dashboard
                                </a>
                                
                                <a asp-area="Client" asp-controller="Events" asp-action="Index" class="dropdown-item">
                                <i class="fa fa-calendar mr-2"></i> Browse Events
                                </a>

                                <a asp-area="Client" asp-controller="Tickets" asp-action="Index" class="dropdown-item">
                                <i class="fa fa-ticket mr-2"></i> My Tickets
                                </a>
                            }
                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Admin"))
                            {
                                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                <i class="fa fa-th-large mr-2"></i> Admin Dashboard
                                </a>
                            }
                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Moderator"))
                            {
                                <a asp-area="Moderator" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                <i class="fa fa-th-large mr-2"></i> Moderator Dashboard
                                </a>
                            }  
                            <div class="dropdown-divider"></div>
                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Organizer"))
                            {
                                <div class="dropdown-divider"></div>
                                <a asp-area="Organizer" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                    <i class="fa fa-calendar-check-o mr-2"></i> Organizer Panel
                                </a>
                            }
                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Supplier"))
                            {
                               
                                <a asp-area="Supplier" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                    <i class="fa fa-briefcase mr-2"></i> Supplier Panel
                                </a>
                            }
                            <div class="dropdown-divider"></div>
                            <form asp-area="" asp-controller="User" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fa fa-sign-out mr-2"></i> Sign Out
                                </button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
<!-- ===== END NAVBAR ===== -->

<main role="main">
    @RenderBody()
</main>

<!-- ===== FOOTER ===== -->
<footer class="eh-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="eh-footer-brand">Event<span>Hub</span></div>
                <p>Your marketplace for discovering and booking amazing events.</p>
            </div>
            <div class="col-md-6 text-md-right d-flex align-items-start justify-content-md-end flex-wrap" style="gap:6px;padding-top:4px;">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="eh-footer-link">Privacy Policy</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="eh-footer-link">Terms of Service</a>
            </div>
        </div>
        <hr class="eh-footer-divider" />
        <p style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin:0;">
            &copy; <script>document.write(new Date().getFullYear());</script> EventHub. All rights reserved.
        </p>
    </div>
</footer>
<!-- ===== END FOOTER ===== -->

<script src="~/lib/travelista/js/vendor/jquery-2.2.4.min.js"></script>
<script src="~/lib/travelista/js/popper.min.js"></script>
<script src="~/lib/travelista/js/vendor/bootstrap.min.js"></script>
<script src="~/lib/travelista/js/easing.min.js"></script>
<script src="~/lib/travelista/js/hoverIntent.js"></script>
<script src="~/lib/travelista/js/superfish.min.js"></script>
<script src="~/lib/travelista/js/main.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();
}
