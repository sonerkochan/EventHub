@{
    ViewData["Title"] = "Invalid Ticket";
}

<div class="container py-4" style="max-width: 480px;">
    <div class="card border-danger">
        <div class="card-body text-center">

            <span style="font-size: 3rem;">X</span>
            <h5 class="text-danger fw-bold mt-2">Invalid Ticket</h5>
            <p class="text-muted small mt-2">
                This QR code is not recognised. The ticket doesnt exist or the code has been tampered with.
            </p>

        </div>
    </div>
</div>