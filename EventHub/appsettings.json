{
  // Moving connection string to secrets.json(user secrets) for better security
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ElasticApm": {
    "ServerUrl": "http://localhost:8200",
    "LogLevel": "Warning",
    "ServiceName": "EventHub-API",
    "Environment": "Development",
    "CaptureBody": "all",
    "CaptureBodyContentTypes": true,
    "CaptureHeaders": true,
    "TransactionSampleRate": 1.0,
    "Enabled": true
  }
}
