@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Supplier.SupplierServiceSearchViewModel

@{
    ViewData["Title"] = "Find Services";
}

<div class="mb-4">
    <h5 class="fw-semibold">Find Services</h5>
    <p class="text-muted small mb-0">Search supplier services for your next event.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="bg-white border rounded p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <label asp-for="SearchTerm" class="form-label small text-muted">Service name or description</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Search catering, sound, decoration..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-dark flex-grow-1">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h6 class="fw-semibold mb-0">Available Services</h6>
    <span class="text-muted small">@Model.Services.Count() result(s)</span>
</div>

@if (!Model.Services.Any())
{
    <div class="text-center py-5 bg-white border rounded">
        <h5 class="text-muted">No services found</h5>
        <p class="text-muted small mb-0">Try a different search term or check back later.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var service in Model.Services)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-3 mb-2">
                            <h5 class="card-title fw-semibold mb-0">@service.Name</h5>
                            @if (service.Price.HasValue)
                            {
                                <span class="badge bg-success-subtle text-success align-self-start">@service.Price.Value.ToString("C")</span>
                            }
                        </div>

                        <p class="text-muted small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(service.Description) ? "No description provided." : service.Description)
                        </p>

                        <div class="border-top pt-3 mt-2">
                            <div class="fw-medium small">@service.SupplierName</div>
                            @if (!string.IsNullOrWhiteSpace(service.SupplierEmail))
                            {
                                <a href="mailto:@service.SupplierEmail" class="small">@service.SupplierEmail</a>
                            }
                        </div>

                        <div class="mt-3">
                            @if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark w-100 py-2">Request pending</span>
                            }
                            else if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Accepted)
                            {
                                <span class="badge bg-success w-100 py-2">Request accepted</span>
                            }
                            else if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Declined)
                            {
                                <form asp-action="Rent" method="post">
                                    <input type="hidden" name="serviceId" value="@service.Id" />
                                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                    <textarea name="message" class="form-control form-control-sm mb-2" rows="2" placeholder="Optional message"></textarea>
                                    <button type="submit" class="btn btn-dark btn-sm w-100">Request Again</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Rent" method="post">
                                    <input type="hidden" name="serviceId" value="@service.Id" />
                                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                    <textarea name="message" class="form-control form-control-sm mb-2" rows="2" placeholder="Optional message"></textarea>
                                    <button type="submit" class="btn btn-dark btn-sm w-100">Rent Service</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
