@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Supplier.SupplierServiceSearchViewModel

@{
    ViewData["Title"] = "Find Services";
}

<style>
    .eh-page-header { margin-bottom:28px; padding-bottom:18px; border-bottom:1px solid #e8ecf0; }
    .eh-page-header h4 { font-family:'Poppins',sans-serif; font-weight:700; font-size:1.4rem; color:#1a1a2e; margin-bottom:4px; }
    .eh-page-header p  { color:#aaa; font-size:0.85rem; margin:0; }
    .eh-search-bar {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 8px;
        padding: 20px 24px;
        margin-bottom: 28px;
    }
    .eh-search-bar .form-label { font-family:'Poppins',sans-serif; font-size:0.75rem; font-weight:600; color:#999; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px; }
    .eh-search-bar .form-control { font-family:'Poppins',sans-serif; font-size:0.88rem; border:1px solid #e0e0e0; border-radius:4px; padding:10px 14px; }
    .eh-search-bar .form-control:focus { border-color:#55a5d2; box-shadow:0 0 0 3px rgba(85,165,210,0.12); outline:none; }
    .eh-btn-search { font-family:'Poppins',sans-serif; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; padding:10px 22px; border-radius:4px; border:none; background:#55a5d2; color:#fff; cursor:pointer; transition:background 0.2s; }
    .eh-btn-search:hover { background:#1a1a2e; }
    .eh-btn-clear { font-family:'Poppins',sans-serif; font-size:0.8rem; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; padding:10px 18px; border-radius:4px; border:1px solid #e0e0e0; background:#fff; color:#aaa; text-decoration:none; display:inline-block; transition:border-color 0.2s,color 0.2s; }
    .eh-btn-clear:hover { border-color:#55a5d2; color:#55a5d2; text-decoration:none; }
    .eh-results-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
    .eh-results-header h6 { font-family:'Poppins',sans-serif; font-weight:700; font-size:0.9rem; color:#1a1a2e; margin:0; }
    .eh-results-header span { font-family:'Poppins',sans-serif; font-size:0.8rem; color:#aaa; }
    .eh-service-card {
        background:#fff; border:1px solid #e8ecf0; border-radius:8px; padding:22px;
        height:100%; display:flex; flex-direction:column;
        transition:box-shadow 0.25s, transform 0.25s;
    }
    .eh-service-card:hover { box-shadow:0 8px 24px rgba(0,0,0,0.09); transform:translateY(-3px); }
    .eh-service-name { font-family:'Poppins',sans-serif; font-weight:700; font-size:1rem; color:#1a1a2e; margin-bottom:6px; }
    .eh-service-price { font-family:'Poppins',sans-serif; font-weight:700; font-size:0.9rem; color:#27ae60; background:#e8f8f0; padding:3px 10px; border-radius:20px; display:inline-block; margin-left:8px; }
    .eh-service-desc { font-size:0.85rem; color:#888; line-height:1.6; flex:1; margin-bottom:16px; }
    .eh-supplier-box { border-top:1px solid #f0f0f0; padding-top:14px; margin-top:auto; }
    .eh-supplier-name { font-family:'Poppins',sans-serif; font-weight:600; font-size:0.82rem; color:#555; margin-bottom:2px; }
    .eh-supplier-email { font-size:0.78rem; color:#55a5d2; }
    .eh-service-actions { margin-top:14px; }
    .eh-status-badge { display:block; text-align:center; padding:9px; border-radius:4px; font-family:'Poppins',sans-serif; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; }
    .status-pending  { background:#fff8e1; color:#ff9800; }
    .status-accepted { background:#e8f8f0; color:#27ae60; }
    .eh-rent-textarea { width:100%; border:1px solid #e0e0e0; border-radius:4px; padding:8px 12px; font-family:'Poppins',sans-serif; font-size:0.82rem; resize:vertical; margin-bottom:8px; }
    .eh-rent-textarea:focus { border-color:#55a5d2; outline:none; }
    .eh-rent-btn { display:block; width:100%; text-align:center; padding:9px; border-radius:4px; border:none; background:#1a1a2e; color:#fff; font-family:'Poppins',sans-serif; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; cursor:pointer; transition:background 0.2s; }
    .eh-rent-btn:hover { background:#55a5d2; }
    .eh-empty { text-align:center; background:#fff; border:1px solid #e8ecf0; border-radius:8px; padding:60px 20px; }
    .eh-empty i { font-size:52px; color:#e0e0e0; display:block; margin-bottom:16px; }
    .eh-empty p { color:#bbb; font-size:0.85rem; margin:0; }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="font-family:'Poppins',sans-serif;border-radius:6px;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="font-family:'Poppins',sans-serif;border-radius:6px;">@TempData["Error"]</div>
}

<div class="eh-page-header">
    <h4><i class="fa fa-briefcase mr-2" style="color:#55a5d2;"></i>Find Services</h4>
    <p>Search supplier services for your next event.</p>
</div>

<div class="eh-search-bar">
    <form asp-action="Index" method="get">
        <div class="row align-items-end g-2">
            <div class="col-md-9">
                <label asp-for="SearchTerm" class="form-label">Service name or description</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Search catering, sound, decoration..." />
            </div>
            <div class="col-md-3 d-flex gap-2 align-items-end">
                <button type="submit" class="eh-btn-search mr-2">Search</button>
                <a asp-action="Index" class="eh-btn-clear">Clear</a>
            </div>
        </div>
    </form>
</div>

<div class="eh-results-header">
    <h6><i class="fa fa-th mr-1" style="color:#55a5d2;"></i> Available Services</h6>
    <span>@Model.Services.Count() result(s)</span>
</div>

@if (!Model.Services.Any())
{
    <div class="eh-empty">
        <i class="fa fa-search"></i>
        <p>No services found. Try a different search term or check back later.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var service in Model.Services)
        {
            <div class="col-md-6 col-xl-4 mb-4">
                <div class="eh-service-card">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="eh-service-name">@service.Name</div>
                        @if (service.Price.HasValue)
                        {
                            <span class="eh-service-price" data-currency-amount="@service.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-currency-source="EUR">@service.PriceText</span>
                        }
                    </div>

                    <p class="eh-service-desc">
                        @(string.IsNullOrWhiteSpace(service.Description) ? "No description provided." : service.Description)
                    </p>

                    <div class="eh-supplier-box">
                        <div class="eh-supplier-name">
                            <i class="fa fa-user mr-1" style="color:#55a5d2;"></i> @service.SupplierName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(service.SupplierEmail))
                        {
                            <a href="mailto:@service.SupplierEmail" class="eh-supplier-email">@service.SupplierEmail</a>
                        }
                    </div>

                    <div class="eh-service-actions">
                        @if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Pending)
                        {
                            <span class="eh-status-badge status-pending">
                                <i class="fa fa-clock-o mr-1"></i> Request Pending
                            </span>
                        }
                        else if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Accepted)
                        {
                            <span class="eh-status-badge status-accepted">
                                <i class="fa fa-check mr-1"></i> Request Accepted
                            </span>
                        }
                        else
                        {
                            <form asp-action="Rent" method="post">
                                <input type="hidden" name="serviceId" value="@service.Id" />
                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                <textarea name="message" class="eh-rent-textarea" rows="2" placeholder="Optional message to supplier..."></textarea>
                                <button type="submit" class="eh-rent-btn">
                                    @(service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Declined ? "Request Again" : "Rent Service")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
