@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Supplier.SupplierServiceSearchViewModel

@{
    ViewData["Title"] = "Find Services";
}

<style>
    .card, .form-control, .btn, .badge {
        border-radius: 1rem !important;
    }
    .card {
        overflow: hidden;
    }

    .toast-popup {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1055;
        min-width: 320px;
        max-width: 450px;
        border-radius: 1rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        transform: translateY(150%);
        animation: slideUpToast 0.4s ease-out forwards, fadeOutToast 0.4s ease 4.5s forwards;
    }
    
    @@keyframes slideUpToast {
        from { transform: translateY(150%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    @@keyframes fadeOutToast {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(150%); opacity: 0; }
    }
</style>

<div class="mb-4">
    <h3 class="fw-bold mb-1"><i class="bi bi-search text-primary me-2"></i> Find Services</h3>
    <p class="text-muted mb-0">Search supplier services for your next event.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="toast-popup bg-white border-0 overflow-hidden d-flex align-items-stretch">
        <div class="bg-success text-white px-4 d-flex align-items-center justify-content-center">
            <i class="bi bi-check-circle-fill fs-4"></i>
        </div>
        <div class="px-4 py-3 flex-grow-1 d-flex flex-column justify-content-center">
            <h6 class="fw-bold mb-1 text-dark">Success!</h6>
            <p class="text-muted mb-0 small">@TempData["Success"]</p>
        </div>
        <button type="button" class="btn-close me-3 align-self-center" onclick="this.closest('.toast-popup').style.display='none';" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="toast-popup bg-white border-0 overflow-hidden d-flex align-items-stretch">
        <div class="bg-danger text-white px-4 d-flex align-items-center justify-content-center">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
        </div>
        <div class="px-4 py-3 flex-grow-1 d-flex flex-column justify-content-center">
            <h6 class="fw-bold mb-1 text-dark">Error</h6>
            <p class="text-muted mb-0 small">@TempData["Error"]</p>
        </div>
        <button type="button" class="btn-close me-3 align-self-center" onclick="this.closest('.toast-popup').style.display='none';" aria-label="Close"></button>
    </div>
}

<form asp-action="Index" method="get" class="bg-white border shadow-sm p-4 mb-4" style="border-radius: 1rem;">
    <div class="row g-3 align-items-center">
        <div class="col-md-9">
            <div class="d-flex align-items-center border px-3" style="border-radius: 1rem; height: 100%; min-height: 48px; background-color: #fff;">
                <i class="bi bi-search text-muted pe-2 fs-5"></i>
                <input asp-for="SearchTerm" class="form-control border-0 shadow-none bg-transparent px-0" placeholder="Search catering, sound, decoration..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1 px-4 text-white fw-medium">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">Clear</a>
        </div>
    </div>
</form>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h6 class="fw-bold text-dark mb-0">Available Services</h6>
    <span class="badge bg-light text-dark border border-secondary border-opacity-25 px-3 py-2" style="border-radius: 1rem;">@Model.Services.Count() result(s)</span>
</div>

@if (!Model.Services.Any())
{
    <div class="text-center py-5 bg-white border shadow-sm" style="border-radius: 1rem;">
        <i class="bi bi-binoculars display-4 text-muted mb-3 opacity-50"></i>
        <h5 class="fw-bold">No services found</h5>
        <p class="text-muted mb-0">Try a different search term or check back later.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var service in Model.Services)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border transition-hover">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title fw-bold text-dark mb-0">@service.Name</h5>
                            @if (service.Price.HasValue)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success fs-6 border border-success border-opacity-25 py-2 px-3">
                                    @($"€{service.Price.Value:0.00}")
                                </span>
                            }
                        </div>

                        <p class="text-secondary small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(service.Description) ? "No description provided." : service.Description)
                        </p>

                        <div class="bg-light p-3 rounded-4 mb-3 border">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-shop text-primary me-2"></i>
                                <div>
                                    <div class="fw-bold text-dark small mb-0">@service.SupplierName</div>
                                    @if (!string.IsNullOrWhiteSpace(service.SupplierEmail))
                                    {
                                        <a href="mailto:@service.SupplierEmail" class="text-decoration-none small text-muted"><i class="bi bi-envelope me-1"></i>Contact Supplier</a>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Pending)
                            {
                                <div class="bg-warning bg-opacity-10 border border-warning border-opacity-25 text-dark fw-medium text-center rounded-3 py-2 w-100 mb-2">
                                    <i class="bi bi-hourglass-split me-1"></i> Request pending
                                </div>
                            }
                            else if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Accepted)
                            {
                                <div class="bg-success bg-opacity-10 border border-success border-opacity-25 text-success fw-medium text-center rounded-3 py-2 w-100 mb-2">
                                    <i class="bi bi-check2-circle me-1"></i> Request accepted
                                </div>
                            }
                            else if (service.CurrentUserRequestStatus == ServiceRentalRequestStatus.Declined)
                            {
                                <form asp-action="Rent" method="post">
                                    <input type="hidden" name="serviceId" value="@service.Id" />
                                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                    <div class="mb-3">
                                        <textarea name="message" class="form-control bg-light border-0 px-3 py-2" rows="2" placeholder="Optional message..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-dark w-100 py-2 fw-medium shadow-sm">
                                        <i class="bi bi-arrow-repeat me-2"></i>Request Again
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Rent" method="post">
                                    <input type="hidden" name="serviceId" value="@service.Id" />
                                    <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                    <div class="mb-3">
                                        <textarea name="message" class="form-control bg-light px-3 py-2" rows="2" placeholder="Write an optional message to the supplier..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-outline-primary w-100 py-2 fw-medium shadow-sm">
                                        <i class="bi bi-cart-plus me-2"></i> Rent Service
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
