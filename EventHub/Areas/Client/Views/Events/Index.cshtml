@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Event.EventListViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="mb-4">
    <h5 class="fw-semibold">Upcoming Events</h5>
    <p class="text-muted small mb-0">@Model.Count() events available</p>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div style="font-size: 80px; opacity: 0.3; margin-bottom: 20px;">🎭</div>
        <h5 class="text-muted">No published events available right now</h5>
        <p class="text-muted small">Check back soon for upcoming events!</p>
    </div>
}
else
{
    <div class="cvei-main-row row g-4 p-6">
        @foreach (var e in Model)
        {
            <div class="cvei-col-card col-md-6 col-lg-4">
                <div class="card cvei-card border-0 shadow-sm h-100 hover-lift" style="transition: all 0.3s;">
                    @if (!string.IsNullOrEmpty(e.CoverImageUrl))
                    {
                        <img src="@e.CoverImageUrl" class="cvei-card-image card-img-top" alt="@e.EventName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="cvei-card-image card-img-top bg-gradient d-flex align-items-center justify-content-center"
                             style="height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <span style="font-size: 64px;">@GetEventIcon(e.EventType)</span>
                        </div>
                    }
                    <div class="cvei-card-body card-body d-flex flex-column">

                        <div class="mb-2">
                            <span class="cvei-badge badge bg-@GetTypeBadgeColor(e.EventType) fw-normal small">@e.EventType</span>
                            <span class="cvei-badge badge bg-secondary fw-normal small ms-1">@e.RoomName</span>
                        </div>

                        <h5 class="cvei-card-title card-title fw-semibold mt-3 mb-3">@e.EventName</h5>
                        <p class="cvei-p mb-1">
                            <i class="cvei-bi bi bi-calendar"></i> @e.StartDateTime.ToString("ddd, MMM dd, yyyy")
                        </p>
                        <p class="cvei-p mb-2">
                            <i class="cvei-bi bi bi-clock"></i> @e.StartDateTime.ToString("h:mm tt")
                        </p>
                        <div class="mt-auto">
                            @if (e.BasePrice > 0)
                            {
                                <div class="mb-2 cvei-price-box-soft">
                                    <span class="cvei-price-box-soft cvei-amount">$@e.BasePrice.ToString("F2")</span>
                                    <small class="text-muted"> per ticket</small>
                                </div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <span class="cvei-badge-free">FREE</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="text-muted">@(e.TotalTickets - e.TicketsSold) / @e.TotalTickets left</small>
                                <div class="progress" style="width: 100px; height: 6px;">
                                    <div class="progress-bar @(e.TotalTickets - e.TicketsSold < e.TotalTickets * 0.2 ? "bg-danger" : "bg-success")" 
                                         role="progressbar" 
                                         style="width: @((e.TotalTickets - e.TicketsSold) * 100.0 / e.TotalTickets)%"></div>
                                </div>
                            </div>
                            <a asp-action="Details" asp-route-id="@e.Id" class="cvei-form-button">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    string GetEventIcon(EventType type) => type switch
    {
        EventType.Conference => "💼",
        EventType.Workshop => "🛠️",
        EventType.Seminar => "🎓",
        EventType.Concert => "🎵",
        EventType.Sports => "⚽",
        EventType.Other => "🎭",
        _ => "🎫"
    };

    string GetTypeBadgeColor(EventType type) => type switch
    {
        EventType.Conference => "primary",
        EventType.Workshop => "warning",
        EventType.Seminar => "info",
        EventType.Concert => "danger",
        EventType.Sports => "success",
        _ => "secondary"
    };
}

<style>
    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>