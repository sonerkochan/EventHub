@model EventHub.Core.Models.Ticket.PurchaseTicketViewModel

@{
    ViewData["Title"] = "Get Tickets";
}

<div class="animate-fade-in" style="max-width: 520px; margin: 0 auto;">
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.EventId" class="btn-modern btn-modern-ghost mb-2" style="padding: 0.375rem 0.75rem;">
            ← Back to Event
        </a>
        <h4 class="fw-bold mb-1">Get Tickets</h4>
        <p class="text-muted-modern mb-0">Reserve your spot for this event</p>
    </div>

    <div class="modern-card mb-3">
        <div class="modern-card-body" style="background: hsl(var(--muted)); border-radius: var(--radius);">
            <h5 class="fw-semibold mb-2">@Model.EventName</h5>
            <div class="d-flex flex-column gap-1">
                <small class="text-muted-modern">📅 @Model.EventStart.ToString("dd MMM yyyy, HH:mm")</small>
                <small class="text-muted-modern">🏛️ @Model.RoomName</small>
                <small class="text-muted-modern">🎫 @Model.AvailableTickets tickets available</small>
                @if (Model.Price > 0)
                {
                    <small class="fw-medium mt-2">Price: $@Model.Price.ToString("F2") per ticket</small>
                }
                else
                {
                    <small class="fw-medium mt-2" style="color: #10b981;">✓ Free Event</small>
                }
            </div>
        </div>
    </div>

    <div class="modern-card">
        <div class="modern-card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger small mb-3">@TempData["Error"]</div>
            }

            <form asp-action="BuyDirect" method="post" class="form-modern">
                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.EventId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="form-group-modern">
                    <label asp-for="Quantity" class="form-label-modern">Number of Tickets</label>
                    <input asp-for="Quantity" type="number" name="quantity" min="1"
                           max="@Math.Min(10, Model.AvailableTickets)"
                           class="form-input-modern" value="1" style="max-width: 150px;" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                @if (Model.Price > 0)
                {
                    <div class="modern-card mb-3" style="background: hsl(var(--muted)); border: none; padding: 1rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-medium">Total:</span>
                            <span class="fw-bold" style="font-size: 1.25rem;">$<span id="totalPrice">@Model.Price.ToString("F2")</span></span>
                        </div>
                    </div>

                    <button type="submit" formaction="@Url.Action("Checkout", "Payment", new { area = "Client" })"
                            formmethod="post" class="btn-modern btn-modern-primary w-100 mb-2" style="padding: 0.75rem;">
                        <input type="hidden" name="unitPrice" value="@Model.Price" />
                        💳 Pay with Stripe
                    </button>
                }

                <button type="submit" class="btn-modern @(Model.Price > 0 ? "btn-modern-outline" : "btn-modern-primary") w-100" style="padding: 0.75rem;">
                    @(Model.Price > 0 ? "🎫 Reserve (Pay Later)" : "🎫 Get Free Tickets")
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const quantityInput = document.querySelector('input[name="quantity"]');
        const pricePerTicket = @Model.Price;
        const totalPriceSpan = document.getElementById('totalPrice');

        if (totalPriceSpan) {
            quantityInput.addEventListener('input', () => {
                const total = (quantityInput.value * pricePerTicket).toFixed(2);
                totalPriceSpan.textContent = total;
            });
        }
    </script>
}
