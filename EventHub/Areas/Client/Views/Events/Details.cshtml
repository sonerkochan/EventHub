@model EventHub.Core.Models.Event.EventDetailViewModel

@{
    ViewData["Title"] = Model.EventName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">@Model.EventName</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border mb-3">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" class="img-fluid rounded mb-3" alt="Event cover" />
                }
                <p class="text-muted">@(Model.Description ?? "No description provided.")</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border mb-3">
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">Start</small>
                    <span class="fw-medium small">@Model.StartDateTime.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">End</small>
                    <span class="fw-medium small">@Model.EndDateTime.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Venue / Room</small>
                    <span class="fw-medium small">@Model.RoomName</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Availability</small>
                    <span class="fw-medium small">@(Model.TotalTickets - Model.TicketsSold) / @Model.TotalTickets tickets left</span>
                </div>

                @if (Model.TotalTickets - Model.TicketsSold > 0)
                {
                    <a asp-action="Buy" asp-route-id="@Model.Id"
                       class="btn btn-dark btn-sm w-100">Get Tickets</a>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm w-100" disabled>Sold Out</button>
                }
            </div>
        </div>
    </div>
</div>