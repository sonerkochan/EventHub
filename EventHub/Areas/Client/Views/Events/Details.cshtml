@model EventHub.Core.Models.Event.EventDetailViewModel
@using System.Globalization
@using System.Text.Json
@using EventHub.Localization
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.Extensions.Localization.IStringLocalizer<ClientResource> ClientLocalizer

@{
    ViewData["Title"] = Model.EventName;
    var googleMapsApiKey = Configuration["GoogleMaps:ApiKey"];
    var hasMapLocation = Model.Latitude != 0 && Model.Longitude != 0;
    var canRenderMap = !string.IsNullOrWhiteSpace(googleMapsApiKey) && hasMapLocation;
    var locationText = string.Join(", ", new[] { Model.Address, Model.City, Model.CountryCode }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
}

<style>
    .eh-back-link {
        display: inline-flex;
        align-items: center;
        font-family: 'Poppins', sans-serif;
        font-size: 0.82rem;
        font-weight: 500;
        color: #55a5d2;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.2s;
    }
    .eh-back-link:hover { color: #1a1a2e; text-decoration: none; }
    .eh-back-link i { margin-right: 6px; }
    .eh-detail-hero {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .eh-detail-hero img {
        width: 100%;
        max-height: 380px;
        object-fit: cover;
        display: block;
    }
    .eh-detail-hero .desc {
        padding: 24px;
        font-size: 0.9rem;
        color: #666;
        line-height: 1.7;
    }
    .eh-info-card {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 8px;
        overflow: hidden;
    }
    .eh-info-card-header {
        background: #1a1a2e;
        padding: 16px 20px;
    }
    .eh-info-card-header h5 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .eh-info-card-body {
        padding: 20px;
    }
    .eh-info-row {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f0f0f0;
    }
    .eh-info-row:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .eh-info-label {
        font-family: 'Poppins', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #bbb;
        margin-bottom: 4px;
    }
    .eh-info-value {
        font-family: 'Poppins', sans-serif;
        font-size: 0.88rem;
        font-weight: 500;
        color: #1a1a2e;
    }
    .eh-info-value i { color: #55a5d2; margin-right: 6px; }
    .eh-book-btn {
        display: block;
        width: 100%;
        text-align: center;
        background: #55a5d2;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 13px;
        border-radius: 4px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 8px;
    }
    .eh-book-btn:hover { background: #1a1a2e; color: #fff; text-decoration: none; }
    .eh-sold-out-btn {
        display: block;
        width: 100%;
        text-align: center;
        background: #e8ecf0;
        color: #aaa;
        font-family: 'Poppins', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 13px;
        border-radius: 4px;
        margin-top: 8px;
        cursor: not-allowed;
    }
    .eh-avail-bar { height: 6px; border-radius: 10px; background: #e8ecf0; overflow: hidden; margin-top: 6px; }
    .eh-avail-bar .fill { height: 100%; border-radius: 10px; }
    .eh-travelis-shell {
        margin-top: 34px;
    }
    .eh-travelis-loading,
    .eh-travelis-empty,
    .eh-travelis-unavailable {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 8px;
        padding: 28px;
        color: #777;
        font-family: 'Poppins', sans-serif;
    }
    .eh-travelis-loading {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .eh-travelis-spinner {
        width: 22px;
        height: 22px;
        border: 3px solid #e8ecf0;
        border-top-color: #55a5d2;
        border-radius: 50%;
        animation: ehTravelisSpin 0.8s linear infinite;
    }
    .eh-travelis-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }
    .eh-travelis-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0;
    }
    .eh-travelis-subtitle {
        color: #777;
        font-size: 0.86rem;
        margin: 4px 0 0;
    }
    .eh-travelis-partner {
        color: #55a5d2;
        font-family: 'Poppins', sans-serif;
        font-size: 0.84rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }
    .eh-travelis-partner:hover {
        color: #1a1a2e;
        text-decoration: none;
    }
    .eh-travelis-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }
    .eh-travelis-card {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 8px;
        overflow: hidden;
        min-width: 0;
        height: 100%;
    }
    .eh-travelis-image,
    .eh-travelis-image-placeholder {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        background: #f4f7fa;
    }
    .eh-travelis-image-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9aa8b3;
        font-size: 1.8rem;
    }
    .eh-travelis-card-body {
        padding: 16px;
        font-family: 'Poppins', sans-serif;
    }
    .eh-travelis-hotel-name {
        color: #1a1a2e;
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.35;
        margin-bottom: 8px;
    }
    .eh-travelis-meta {
        color: #666;
        font-size: 0.82rem;
        line-height: 1.55;
        margin-bottom: 8px;
        word-break: break-word;
    }
    .eh-travelis-meta i {
        color: #55a5d2;
        margin-right: 6px;
        width: 14px;
        text-align: center;
    }
    .eh-travelis-carousel-control {
        width: 34px;
        height: 34px;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(26, 26, 46, 0.62);
        border-radius: 50%;
        opacity: 1;
        margin: 0 10px;
    }
    .eh-travelis-carousel-control i {
        color: #fff;
        font-size: 0.9rem;
    }
    @@keyframes ehTravelisSpin {
        to { transform: rotate(360deg); }
    }
    @@media (max-width: 991px) {
        .eh-travelis-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 575px) {
        .eh-travelis-header {
            display: block;
        }
        .eh-travelis-partner {
            display: inline-block;
            margin-top: 8px;
            white-space: normal;
        }
        .eh-travelis-grid { grid-template-columns: 1fr; }
    }
</style>

<a asp-action="Index" class="eh-back-link">
    <i class="fa fa-arrow-left"></i> @ClientLocalizer["Client.Events.BackToEvents"]
</a>

<div class="row">
    <div class="col-lg-8">
        <div class="eh-detail-hero">
            @if (!string.IsNullOrEmpty(Model.CoverImageDisplayUrl))
            {
                <img src="@Model.CoverImageDisplayUrl"
                     class="img-fluid rounded mb-4"
                     alt="@Model.EventName"
                     style="max-height:300px;object-fit:cover;width:100%" />
            }
            <div class="desc">
                <h4 style="font-family:'Poppins',sans-serif;font-weight:700;color:#1a1a2e;margin-bottom:14px;">@Model.EventName</h4>
                @(Model.Description ?? ClientLocalizer["Client.Events.NoDescription"])
            </div>
        </div>

        <div class="card eh-surface">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h6 class="fw-semibold mb-1">@ClientLocalizer["Client.Events.Location"]</h6>
                        <p class="text-muted small mb-0">@(string.IsNullOrWhiteSpace(locationText) ? ClientLocalizer["Client.Events.LocationMissing"] : locationText)</p>
                    </div>
                    @if (hasMapLocation)
                    {
                        <span class="eh-badge eh-badge-muted">@Model.Latitude.ToString("0.#######", CultureInfo.InvariantCulture), @Model.Longitude.ToString("0.#######", CultureInfo.InvariantCulture)</span>
                    }
                </div>

                @if (canRenderMap)
                {
                    <div id="event-map" class="eh-map"></div>
                }
                else
                {
                    <div class="eh-map-placeholder">
                        <div class="fw-medium">@ClientLocalizer["Client.Events.MapUnavailable"]</div>
                        <div class="text-muted small">
                            @if (string.IsNullOrWhiteSpace(googleMapsApiKey))
                            {
                                <span>@ClientLocalizer["Client.Events.MapApiMissing"]</span>
                            }
                            else
                            {
                                <span>@ClientLocalizer["Client.Events.MapCoordinatesMissing"]</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="eh-info-card">
            <div class="eh-info-card-header">
                <h5>@Model.EventName</h5>
            </div>
            <div class="eh-info-card-body">
                <div class="eh-info-row">
                    <div class="eh-info-label">@ClientLocalizer["Client.Events.Start"]</div>
                    <div class="eh-info-value">
                        <i class="fa fa-calendar"></i> @Model.StartDateTime.ToString("dd MMM yyyy, HH:mm")
                    </div>
                </div>
                <div class="eh-info-row">
                    <div class="eh-info-label">@ClientLocalizer["Client.Events.End"]</div>
                    <div class="eh-info-value">
                        <i class="fa fa-calendar-check-o"></i> @Model.EndDateTime.ToString("dd MMM yyyy, HH:mm")
                    </div>
                </div>
                <div class="eh-info-row">
                    <div class="eh-info-label">@ClientLocalizer["Client.Events.VenueRoom"]</div>
                    <div class="eh-info-value">
                        <i class="fa fa-map-marker"></i> @Model.RoomName
                    </div>
                </div>
                <div class="eh-info-row">
                    <div class="eh-info-label">@ClientLocalizer["Client.Events.Price"]</div>
                    <div class="eh-info-value">
                        @if (!Model.IsFree)
                        {
                            <i class="fa fa-credit-card"></i>
                            <span data-currency-amount="@Model.PriceAmount?.ToString(CultureInfo.InvariantCulture)" data-currency-source="EUR">@Model.PriceText</span>
                            <small class="text-muted"> @ClientLocalizer["Client.Events.TicketSuffix"]</small>
                        }
                        else
                        {
                            <i class="fa fa-ticket"></i>
                            <span>@ClientLocalizer["Client.Events.Free"]</span>
                        }
                    </div>
                </div>
                <div class="eh-info-row">
                    <div class="eh-info-label">@ClientLocalizer["Client.Events.Available"]</div>
                    <div class="eh-info-value">
                        <i class="fa fa-ticket"></i>
                        @ClientLocalizer["Client.Events.TicketsLeft", Model.TotalTickets - Model.TicketsSold, Model.TotalTickets]
                    </div>
                    @{
                        var pct = Model.TotalTickets > 0 ? (Model.TotalTickets - Model.TicketsSold) * 100.0 / Model.TotalTickets : 0;
                        var isLow = pct < 20;
                    }
                    <div class="eh-avail-bar">
                        <div class="fill" style="width:@pct%;background:@(isLow ? "#e74c3c" : "#27ae60");"></div>
                    </div>
                </div>

                @if (Model.TotalTickets - Model.TicketsSold > 0)
                {
                    <a asp-action="Buy" asp-route-id="@Model.Id" class="eh-book-btn">
                        <i class="fa fa-ticket mr-1"></i> @ClientLocalizer["Client.Events.GetTickets"]
                    </a>
                }
                else
                {
                    <div class="eh-sold-out-btn">@ClientLocalizer["Client.Events.SoldOut"]</div>
                }
            </div>
        </div>
    </div>
</div>

<div id="travelis-hotels"
     class="eh-travelis-shell"
     data-url="@Url.Action("TravelisHotels", "Events", new { area = "Client", eventId = Model.Id })">
    <div class="eh-travelis-loading" role="status" aria-live="polite">
        <span class="eh-travelis-spinner" aria-hidden="true"></span>
        <span>Finding nearby stays...</span>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const container = document.getElementById("travelis-hotels");
            if (!container) {
                return;
            }

            fetch(container.dataset.url, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Unable to load Travelis hotels.");
                    }

                    return response.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    if (window.jQuery) {
                        window.jQuery(container).find(".carousel").carousel({ interval: false });
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="eh-travelis-unavailable"><strong>Nearby stays are unavailable right now.</strong><br><span>Please check again in a moment.</span></div>';
                });
        })();
    </script>

    @if (canRenderMap)
    {
        <script>
            window.initEventMap = function () {
                const eventLocation = {
                    lat: @Model.Latitude.ToString(CultureInfo.InvariantCulture),
                    lng: @Model.Longitude.ToString(CultureInfo.InvariantCulture)
                };

                const mapElement = document.getElementById("event-map");
                if (!mapElement || !window.google?.maps) {
                    return;
                }

                const map = new google.maps.Map(mapElement, {
                    zoom: 14,
                    center: eventLocation,
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true
                });

                new google.maps.Marker({
                    position: eventLocation,
                    map,
                    title: @Html.Raw(JsonSerializer.Serialize(Model.EventName))
                });
            };
        </script>
        <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&callback=initEventMap" async defer></script>
    }
}
