@using EventHub.Core.Models.ApplicationForm
@model ApplicationFormViewModel

@{
   ViewData["Title"] = $"Apply as {Model.Type}";
}

<link rel="stylesheet" href="~/css/applicationForms.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/forms.css" asd-append-version="true" />

<div class="form-wrapper">
    <div class="form-box">
        <div class="heading">Apply as @Model.Type</div>
        
        <form asp-action="Apply" method="post" class="form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Type" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="input-group">
                <label asp-for="Name" class="form-label">Organization Name</label>
                <input asp-for="Name" class="input" placeholder="Enter Name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="input-group">
                <label asp-for="PhoneNumber" class="form-label">Contact Phone</label>
                <input asp-for="PhoneNumber" class="input" placeholder="Phone Number" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>

            <div class="input-group">
                <label asp-for="Description" class="form-label">Tell us about yourself</label>
                    <textarea asp-for="Description" class="input input-textarea" rows="4" placeholder="Your description..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <button type="submit" class="form-button">Submit Application</button>
            
            <div class="agreement">
                <a asp-action="Index">Go Back</a>
            </div>
        </form>
    </div>
</div>

    @section Scripts {
        @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    }