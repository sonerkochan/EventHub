@using EventHub.Core.Models.ApplicationForm
@model ApplicationFormViewModel

@{
    ViewData["Title"] = $"Apply as {Model.Type}";
}
<link rel="stylesheet" href="~/css/applicationForms.css"  asp-append-version="true" />

<a asp-action="Index" class="eh-back-link">
    <i class="fa fa-arrow-left"></i> Back to Applications
</a>

<div class="eh-apply-wrapper">
    <div class="eh-apply-card">
        <div class="eh-apply-header">
            <h4>Apply as @Model.Type</h4>
            <p>Fill in the details below to submit your application.</p>
        </div>
        <div class="eh-apply-body">
            <form asp-action="Apply" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Type" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="eh-form-group">
                    <label asp-for="Name" class="eh-form-label">Organization Name</label>
                    <input asp-for="Name" class="eh-form-control" placeholder="Enter your organization name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="eh-form-group">
                    <label asp-for="PhoneNumber" class="eh-form-label">Contact Phone</label>
                    <input asp-for="PhoneNumber" class="eh-form-control" placeholder="Your phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="eh-form-group">
                    <label asp-for="Description" class="eh-form-label">Tell us about yourself</label>
                    <textarea asp-for="Description" class="eh-form-control" rows="4" placeholder="Describe your experience and what you'd like to do..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <button type="submit" class="eh-submit-btn">
                    <i class="fa fa-paper-plane mr-1"></i> Submit Application
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
