@using EventHub.Infrastructure.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Applications";
}

<link rel="stylesheet" href="~/css/roleApplicationButtons.css" asp-append-version="true" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert" style="font-family:'Poppins',sans-serif;border-radius:6px;">
        @TempData["Success"]
        <button type="button" class="btn-close" data-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert" style="font-family:'Poppins',sans-serif;border-radius:6px;">
        @TempData["Error"]
        <button type="button" class="btn-close" data-dismiss="alert"></button>
    </div>
}

<div class="eh-page-header">
    <h4><i class="fa fa-file-text-o mr-2" style="color:#55a5d2;"></i>Applications</h4>
    <p>Apply to become an Organizer or Supplier on the platform.</p>
</div>

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    <div class="row">
        <div class="col-md-6 mb-4">
            @if (!(await UserManager.IsInRoleAsync(currentUser!, "Organizer")))
            {
                <a asp-action="Apply" asp-route-type="1" class="eh-app-card-link">
                    <div class="eh-app-card">
                        <div class="eh-app-icon"><i class="fa fa-calendar"></i></div>
                        <div class="eh-app-title">Organizer</div>
                        <p class="eh-app-desc">Create and manage events, venues, and ticket sales on the EventHub platform.</p>
                        <div class="eh-app-cta">Apply as Organizer <i class="fa fa-arrow-right"></i></div>
                    </div>
                </a>
            }
            else
            {
                <div class="eh-app-card">
                    <div class="eh-app-icon"><i class="fa fa-calendar"></i></div>
                    <div class="eh-app-title">Organizer</div>
                    <p class="eh-app-desc">Create and manage events, venues, and ticket sales on the EventHub platform.</p>
                    <div>
                        <span class="eh-active-badge"><i class="fa fa-check-circle"></i> Active</span>
                    </div>
                    <div class="eh-active-note">You are registered as an Organizer.</div>
                </div>
            }
        </div>

        <div class="col-md-6 mb-4">
            @if (!(await UserManager.IsInRoleAsync(currentUser!, "Supplier")))
            {
                <a asp-action="Apply" asp-route-type="2" class="eh-app-card-link">
                    <div class="eh-app-card">
                        <div class="eh-app-icon"><i class="fa fa-briefcase"></i></div>
                        <div class="eh-app-title">Supplier</div>
                        <p class="eh-app-desc">Provide goods and services to event organizers on the platform.</p>
                        <div class="eh-app-cta">Apply as Supplier <i class="fa fa-arrow-right"></i></div>
                    </div>
                </a>
            }
            else
            {
                <div class="eh-app-card">
                    <div class="eh-app-icon"><i class="fa fa-briefcase"></i></div>
                    <div class="eh-app-title">Supplier</div>
                    <p class="eh-app-desc">Provide goods and services to event organizers on the platform.</p>
                    <div>
                        <span class="eh-active-badge"><i class="fa fa-check-circle"></i> Active</span>
                    </div>
                    <div class="eh-active-note">You are registered as a Supplier.</div>
                </div>
            }
        </div>
    </div>
}
