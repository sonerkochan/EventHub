@using EventHub.Infrastructure.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Applications";
}

<link rel="stylesheet" href="~/css/applicationForms.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/forms.css" asp-append-version="true"/>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);

    <div class="row g-3">
            <div class="col-md-6">
                @if (!(await UserManager.IsInRoleAsync(currentUser!, "Organizer")))
                {
                    <a asp-action="Apply" asp-route-type="1" class="text-decoration-none">
                        <div class="form-box hover-lift selection-card">
                            <div class="card-body">
                                <h6 class="heading-sm">Organizer</h6>
                                <p class="text-muted small">Create and manage events, venues, and ticket sales.</p>
                                <div class="apply-text">Apply As Organizer Now &rarr;</div>
                            </div>
                        </div>
                    </a>
                
                }
                else
                {
                    <div class="form-box hover-lift selection-card">
                        <div class="card-body">
                            <h6 class="heading-sm">Supplier</h6>
                            <p class="text-muted small">Create and manage events, venues, and ticket sales.</p>
                            <span class="badge bg-success">Active</span>

                            <div class="text-success small fw-bold">You are already registered as Organizer</div>
                        </div>
                       
                    </div>
                }
            </div>

        <div class="col-md-6">                   
                @if (!(await UserManager.IsInRoleAsync(currentUser!, "Supplier")))
                {
                    <a asp-action="Apply" asp-route-type="2" class="text-decoration-none">
                        <div class="form-box hover-lift selection-card">
                            <div class="card-body">
                                <h6 class="heading-sm">Supplier</h6>
                                <p class="text-muted small">Provide goods and services to event organizers on the platform.</p>
                                <div class="apply-text">Apply As Supplier Now &rarr;</div>
                            </div>
                        </div>
                    </a>
                    
                }
                else
                {                  
                    <div class="form-box hover-lift selection-card">
                        <div class="card-body">
                            <h6 class="heading-sm">Supplier</h6>
                            <p class="text-muted small">Provide goods and services to event organizers on the platform.</p>
                            <span class="badge bg-success">Active</span>
                            <div class="text-success small fw-bold">You are already registered as Supplier</div>
                        </div>
                        
                    </div>
                }     
        </div>
    </div>
}
