@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="text-center py-5">
    <div class="mb-3 text-secondary" style="font-size: 3rem;">&#215;</div>
    <h5 class="fw-semibold">Payment Cancelled</h5>
    <p class="text-muted small mb-4">No charge was made. You can try again whenever you're ready.</p>
    <a asp-area="Client" asp-controller="Events" asp-action="Details" asp-route-id="@ViewBag.EventId"
       class="btn btn-dark btn-sm">Back to @ViewBag.EventName</a>
</div>