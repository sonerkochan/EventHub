@{
    ViewData["Title"] = "Payment Successful";
}

<style>
    .eh-result-wrapper {
        max-width: 500px;
        margin: 60px auto;
        text-align: center;
    }
    .eh-result-icon {
        width: 80px; height: 80px;
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        color: #fff;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(39,174,96,0.3);
    }
    .eh-result-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: #1a1a2e;
        margin-bottom: 12px;
    }
    .eh-result-desc {
        font-family: 'Poppins', sans-serif;
        font-size: 0.88rem;
        color: #888;
        line-height: 1.6;
        margin-bottom: 32px;
    }
    .eh-result-btn {
        display: inline-block;
        background: #55a5d2;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 12px 28px;
        border-radius: 4px;
        text-decoration: none;
        transition: background 0.2s;
    }
    .eh-result-btn:hover { background: #1a1a2e; color: #fff; text-decoration: none; }
</style>

<div class="eh-result-wrapper">
    <div class="eh-result-icon">
        <i class="fa fa-check"></i>
    </div>
    <div class="eh-result-title">Payment Successful!</div>
    <p class="eh-result-desc">
        Your tickets are being confirmed. They will appear in your ticket list shortly.
    </p>
    <a asp-area="Client" asp-controller="Tickets" asp-action="Index" class="eh-result-btn">
        <i class="fa fa-ticket mr-1"></i> View My Tickets
    </a>
</div>
