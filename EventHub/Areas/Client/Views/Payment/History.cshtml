@model IEnumerable<EventHub.Core.Models.Payment.PaymentListViewModel>

@{
    ViewData["Title"] = "Payment History";
}

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Event</th>
                    <th class="small">Amount</th>
                    <th class="small">Status</th>
                    <th class="small">Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="small fw-medium">@p.EventName</td>
                        <td class="small">@p.Currency @p.Amount.ToString("F2")</td>
                        <td>
                            <span class="badge fw-normal bg-@(p.Status == "Accepted" ? "success" : p.Status == "Refunded" ? "warning" : "danger")">
                                @p.Status
                            </span>
                        </td>
                        <td class="small">@p.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted small py-4">No payment history yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>