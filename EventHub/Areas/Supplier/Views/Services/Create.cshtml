@model EventHub.Areas.Supplier.Models.ServiceCreateViewModel

@{
    ViewData["Title"] = "Create Service";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<div class="row w-100 mb-4">
    <div class="col-12">
        <h3 class="mb-0 fw-bold d-flex align-items-center">
            <i class="bi bi-plus-circle text-primary me-2"></i> Create a New Service
        </h3>
        <p class="text-muted mt-2">Add a new service to your catalog.</p>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" class="row g-4">
            
            <div class="col-md-8">
                <label asp-for="Name" class="form-label fw-semibold">Service Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Catering, Photography, Decor..." />
                </div>
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Price" class="form-label fw-semibold">Price</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                    <input asp-for="Price" class="form-control form-control-lg" placeholder="0.00" />
                </div>
                <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide details about what this service includes..."></textarea>
                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                <div class="form-text">Be specific to attract more event organizers.</div>
            </div>

            <div class="col-12 mt-4 pt-2 border-top d-flex align-items-center">
                <button type="submit" class="btn btn-primary btn-lg px-4 d-flex align-items-center">
                    <i class="bi bi-check-lg me-2"></i> Create Service
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
