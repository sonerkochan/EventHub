@model IEnumerable<EventHub.Infrastructure.Data.Models.SupplierService>

@{
    ViewData["Title"] = "My Services";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
    var priceTexts = ViewBag.PriceTexts as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<h3>My Services</h3>

<p>
    <a asp-area="Supplier" asp-controller="Services" asp-action="Create" class="btn btn-primary">Create new service</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Actions</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    @if (item.Price.HasValue && priceTexts.TryGetValue(item.Id, out var priceText))
                    {
                        <span data-currency-amount="@item.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-currency-source="EUR">@priceText</span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>
                    <a asp-area="Supplier" asp-controller="Services" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                    <a asp-area="Supplier" asp-controller="Services" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" class="text-muted">No services created yet.</td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
