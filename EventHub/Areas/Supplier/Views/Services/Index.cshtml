@model IEnumerable<EventHub.Infrastructure.Data.Models.SupplierService>

@{
    ViewData["Title"] = "My Services";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-list-ul text-primary me-2"></i> My Services</h3>
        <p class="text-muted mb-0">Manage the services you offer to organizers.</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createServiceModal">
        <i class="bi bi-plus-lg me-2"></i> Add New Service
    </button>
</div>

<!-- Search and Filter Bar -->
@if (Model != null && Model.Any())
{
    <div class="row mb-4">
        <div class="col-md-8 mb-2 mb-md-0">
            <div class="d-flex align-items-center border shadow-sm px-3" style="border-radius: 1rem; height: 100%; min-height: 48px; background-color: #fff;">
                <i class="bi bi-search text-muted pe-2 fs-5"></i>
                <input type="text" id="searchInput" class="form-control border-0 shadow-none bg-transparent px-0" placeholder="Search by service name or description...">
            </div>
        </div>
        <div class="col-md-4">
            <select id="sortSelect" class="form-select form-select-lg shadow-sm">
                <option value="default">Sort by: Default (Newest)</option>
                <option value="price_asc">Price: Low to High</option>
                <option value="price_desc">Price: High to Low</option>
                <option value="name_asc">Name: A to Z</option>
            </select>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="servicesGrid">
        @foreach (var item in Model)
        {
            <div class="col service-item" data-name="@item.Name.ToLower()" data-desc="@(item.Description?.ToLower() ?? "")" data-price="@(item.Price ?? 0)" data-date="@item.CreatedAt.Ticks">
                <div class="card h-100 shadow-sm border-1 transition-hover">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-dark mb-0">@item.Name</h5>
                            <span class="badge bg-success bg-opacity-10 text-success fs-6 border border-success border-opacity-25 rounded-pill px-3 py-2">
                                @(item.Price.HasValue ? $"€{item.Price.Value:0.00}" : "On Request")
                            </span>
                        </div>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-calendar-check me-1"></i> Created on @item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </p>
                        <p class="card-text text-secondary mb-4" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)
                        </p>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 mt-auto">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm flex-grow-1 d-flex justify-content-center align-items-center" data-bs-toggle="modal" data-bs-target="#editServiceModal-@item.Id">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm flex-grow-1 d-flex justify-content-center align-items-center" data-bs-toggle="modal" data-bs-target="#deleteServiceModal-@item.Id">
                                <i class="bi bi-trash me-1"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Service Modal for @item.Id -->
            <div class="modal fade" id="deleteServiceModal-@item.Id" tabindex="-1" aria-labelledby="deleteServiceModalLabel-@item.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header border-bottom-0 pb-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center p-4 pt-0">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger mb-4" style="width: 80px; height: 80px;">
                                <i class="bi bi-exclamation-triangle fs-1"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Delete Service?</h4>
                            <p class="text-muted mb-4">
                                Are you sure you want to delete <strong>@item.Name</strong>? This action cannot be undone.
                            </p>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <div class="d-flex gap-3 justify-content-center mt-2">
                                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger px-4">
                                        <i class="bi bi-trash me-2"></i> Yes, Delete
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Service Modal for @item.Id -->
            <div class="modal fade" id="editServiceModal-@item.Id" tabindex="-1" aria-labelledby="editServiceModalLabel-@item.Id" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header border-bottom px-4">
                            <h5 class="modal-title fw-bold d-flex align-items-center" id="editServiceModalLabel-@item.Id">
                                <i class="bi bi-pencil-square text-primary me-2"></i> Edit Service
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-action="Edit" method="post">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <div class="modal-body p-4 row g-4">
                                <div class="col-md-8">
                                    <label for="Name-@item.Id" class="form-label fw-semibold">Service Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                        <input type="text" name="Name" id="Name-@item.Id" class="form-control form-control-lg" value="@item.Name" required />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label for="Price-@item.Id" class="form-label fw-semibold">Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-currency-euro"></i></span>
                                        <input type="number" step="0.01" min="0" name="Price" id="Price-@item.Id" class="form-control form-control-lg" value="@(item.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" required />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label for="Description-@item.Id" class="form-label fw-semibold">Description</label>
                                    <textarea name="Description" id="Description-@item.Id" class="form-control" rows="4">@item.Description</textarea>
                                </div>
                            </div>
                            <div class="modal-footer px-4 border-top bg-light">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary d-flex align-items-center">
                                    <i class="bi bi-check-lg me-2"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-3 mt-4">
        <div class="card-body py-5">
            <i class="bi bi-box-seam display-1 text-muted mb-3 opacity-50"></i>
            <h4 class="fw-bold">No services yet</h4>
            <p class="text-muted mx-auto" style="max-width: 400px;">
                You haven't created any services to offer. Click the button below to add your first service and start receiving requests!
            </p>
            <button type="button" class="btn btn-primary mt-3 px-4 py-2" data-bs-toggle="modal" data-bs-target="#createServiceModal">
                <i class="bi bi-plus-lg me-2"></i> Add First Service
            </button>
        </div>
    </div>
}

<!-- Create Service Modal -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-labelledby="createServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom px-4">
                <h5 class="modal-title fw-bold d-flex align-items-center" id="createServiceModalLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i> Create a New Service
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4 row g-4">
                    <div class="col-md-8">
                        <label for="Name" class="form-label fw-semibold">Service Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                            <input type="text" name="Name" id="Name" class="form-control form-control-lg" placeholder="e.g. Catering, Photography..." required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label for="Price" class="form-label fw-semibold">Price</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-currency-euro"></i></span>
                            <input type="number" step="0.01" min="0" name="Price" id="Price" class="form-control form-control-lg" placeholder="0.00" required />
                        </div>
                    </div>

                    <div class="col-12">
                        <label for="Description" class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="Description" class="form-control" rows="4" placeholder="Provide details about what this service includes..."></textarea>
                        <div class="form-text">Be specific to attract more event organizers.</div>
                    </div>
                </div>
                <div class="modal-footer px-4 border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-flex align-items-center">
                        <i class="bi bi-check-lg me-2"></i> Create Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    /* Simple fade animation for filtering */
    .service-item {
        transition: opacity 0.3s ease;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const sortSelect = document.getElementById('sortSelect');
            const servicesGrid = document.getElementById('servicesGrid');
            
            if (!servicesGrid) return; // grid doesn't exist if no services

            const serviceItems = Array.from(servicesGrid.getElementsByClassName('service-item'));

            function filterAndSort() {
                const searchTerm = searchInput.value.toLowerCase();
                const sortValue = sortSelect.value;
                
                // 1. Filter
                let visibleItems = [];
                serviceItems.forEach(item => {
                    const name = item.getAttribute('data-name');
                    const desc = item.getAttribute('data-desc');
                    
                    if (name.includes(searchTerm) || desc.includes(searchTerm)) {
                        item.style.display = ''; // Show
                        item.classList.add('d-block');
                        visibleItems.push(item);
                    } else {
                        item.style.display = 'none'; // Hide
                        item.classList.remove('d-block');
                    }
                });

                // 2. Sort
                visibleItems.sort((a, b) => {
                    const priceA = parseFloat(a.getAttribute('data-price')) || 0;
                    const priceB = parseFloat(b.getAttribute('data-price')) || 0;
                    const nameA = a.getAttribute('data-name');
                    const nameB = b.getAttribute('data-name');
                    const dateA = parseInt(a.getAttribute('data-date')) || 0;
                    const dateB = parseInt(b.getAttribute('data-date')) || 0;

                    if (sortValue === 'price_asc') {
                        return priceA - priceB;
                    } else if (sortValue === 'price_desc') {
                        return priceB - priceA;
                    } else if (sortValue === 'name_asc') {
                        return nameA.localeCompare(nameB);
                    } else {
                        // default: newest first
                        return dateB - dateA;
                    }
                });

                // 3. Re-append in sorted order
                visibleItems.forEach(item => servicesGrid.appendChild(item));
            }

            if (searchInput) {
                searchInput.addEventListener('input', filterAndSort);
            }
            if (sortSelect) {
                sortSelect.addEventListener('change', filterAndSort);
            }
        });
    </script>

    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
