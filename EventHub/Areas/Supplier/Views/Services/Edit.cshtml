@model EventHub.Areas.Supplier.Models.ServiceCreateViewModel

@{
    ViewData["Title"] = "Edit Service";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<h3>Edit Service</h3>

<form asp-action="Edit" method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Supplier" asp-controller="Services" asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
