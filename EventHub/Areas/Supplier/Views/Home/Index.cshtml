@{
    ViewData["Title"] = "Supplier Dashboard";
}

<div class="page-header">
    <h1 class="page-title">Supplier Dashboard</h1>
    <div class="page-options">
        <a asp-area="Supplier" asp-controller="Services" asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus mr-1"></i> Create Service
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-xl-4">
        <div class="card">
            <div class="card-status bg-primary"></div>
            <div class="card-body">
                <h3 class="card-title">My Services</h3>
                <p class="text-muted">Manage the services you offer to event organizers.</p>
                <a asp-area="Supplier" asp-controller="Services" asp-action="Index" class="btn btn-secondary">
                    View Services
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4">
        <div class="card">
            <div class="card-status bg-success"></div>
            <div class="card-body">
                <h3 class="card-title">Service Requests</h3>
                <p class="text-muted">Review organizer requests and rental activity.</p>
                <a asp-area="Supplier" asp-controller="Requests" asp-action="Index" class="btn btn-secondary">
                    View Requests
                </a>
            </div>
        </div>
    </div>
</div>
