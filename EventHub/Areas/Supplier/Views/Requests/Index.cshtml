@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Supplier.ServiceRentalRequestListViewModel>

@{
    ViewData["Title"] = "Service Requests";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<div class="mb-4">
    <h3>Service Requests</h3>
    <p class="text-muted small mb-0">Review rental requests from clients and organizers.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 bg-white border rounded">
        <h5 class="text-muted">No service requests yet</h5>
        <p class="text-muted small mb-0">Requests will appear here when someone rents one of your services.</p>
    </div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Requester</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th style="width: 260px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@request.ServiceName</div>
                            <small class="text-muted">@(request.Price.HasValue ? request.Price.Value.ToString("C") : "No price set")</small>
                        </td>
                        <td>
                            <div>@request.RequesterName</div>
                            @if (!string.IsNullOrWhiteSpace(request.RequesterEmail))
                            {
                                <a href="mailto:@request.RequesterEmail" class="small">@request.RequesterEmail</a>
                            }
                        </td>
                        <td class="small text-muted">
                            @(string.IsNullOrWhiteSpace(request.Message) ? "No message." : request.Message)
                            @if (!string.IsNullOrWhiteSpace(request.ResponseComment))
                            {
                                <div class="mt-2"><strong>Response:</strong> @request.ResponseComment</div>
                            }
                        </td>
                        <td>
                            @if (request.Status == ServiceRentalRequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (request.Status == ServiceRentalRequestStatus.Accepted)
                            {
                                <span class="badge bg-success">Accepted</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Declined</span>
                            }
                        </td>
                        <td>
                            <small>@request.RequestedAt.ToLocalTime().ToString("g")</small>
                        </td>
                        <td>
                            @if (request.Status == ServiceRentalRequestStatus.Pending)
                            {
                                <form asp-action="Accept" method="post" class="mb-2">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <input name="responseComment" class="form-control form-control-sm mb-2" placeholder="Optional response" />
                                    <button type="submit" class="btn btn-sm btn-success w-100">Accept</button>
                                </form>
                                <form asp-action="Decline" method="post">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <input name="responseComment" class="form-control form-control-sm mb-2" placeholder="Optional reason" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Decline</button>
                                </form>
                            }
                            else if (request.ReviewedAt.HasValue)
                            {
                                <small class="text-muted">Reviewed @request.ReviewedAt.Value.ToLocalTime().ToString("g")</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
