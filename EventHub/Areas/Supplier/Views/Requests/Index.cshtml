@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Supplier.ServiceRentalRequestListViewModel>

@{
    ViewData["Title"] = "Service Requests";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<div class="page-header mt-5 mb-4">
    <h1 class="page-title" style="font-size: 2rem;">Service Requests</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible shadow-sm fade show" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"></button>
        <i class="fa fa-check-circle mr-2"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible shadow-sm fade show" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"></button>
        <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="card p-5 text-center border-0" style="border-radius: 20px;">
        <i class="fa fa-inbox text-muted mb-3" style="font-size: 4rem; opacity: 0.2;"></i>
        <h3 class="text-muted font-weight-bold">No service requests yet</h3>
        <p class="text-muted mb-0" style="font-size: 1.1rem;">Requests will appear here when someone rents one of your services.</p>
    </div>
}
else
{
    <div class="card border-0" style="border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover table-vcenter text-nowrap card-table mb-0">
                <thead style="background: #f8fafc; border-bottom: 1px solid rgba(0,0,0,0.03);">
                    <tr>
                        <th class="text-muted font-weight-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Service</th>
                        <th class="text-muted font-weight-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Requester</th>
                        <th class="text-muted font-weight-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Message</th>
                        <th class="text-muted font-weight-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Status</th>
                        <th class="text-muted font-weight-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">Requested</th>
                        <th class="text-center w-1"><i class="icon-settings"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-600" style="color:#2b5876;">@request.ServiceName</div>
                                <div class="small text-muted mt-1">
                                    <i class="fa fa-tag"></i> 
                                    @if (request.Price.HasValue)
                                    {
                                        <span data-currency-amount="@request.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-currency-source="EUR">@request.PriceText</span>
                                    }
                                    else
                                    {
                                        <span>No price set</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="font-weight-600">@request.RequesterName</div>
                                @if (!string.IsNullOrWhiteSpace(request.RequesterEmail))
                                {
                                    <div class="small text-muted mt-1"><i class="fa fa-envelope-o text-primary"></i> <a href="mailto:@request.RequesterEmail" class="text-inherit">@request.RequesterEmail</a></div>
                                }
                            </td>
                            <td>
                                <div class="text-muted text-wrap" style="max-width: 250px; font-size:0.9rem;">
                                    @(string.IsNullOrWhiteSpace(request.Message) ? "No message." : request.Message)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(request.ResponseComment))
                                {
                                    <div class="small text-muted mt-2 p-2 bg-light text-wrap" style="max-width: 250px; border-radius:6px;">
                                        <strong>Reply:</strong> @request.ResponseComment
                                    </div>
                                }
                            </td>
                            <td>
                                @if (request.Status == ServiceRentalRequestStatus.Pending)
                                {
                                    <span class="badge badge-pill font-weight-bold" style="background: rgba(255, 193, 7, 0.15); color: #8a6d00; padding: 0.6em 1.2em; font-size:0.8rem;"><i class="fa fa-clock-o mr-1"></i> Pending</span>
                                }
                                else if (request.Status == ServiceRentalRequestStatus.Accepted)
                                {
                                    <span class="badge badge-pill font-weight-bold" style="background: rgba(17, 153, 142, 0.15); color: #0e746a; padding: 0.6em 1.2em; font-size:0.8rem;"><i class="fa fa-check mr-1"></i> Accepted</span>
                                }
                                else
                                {
                                    <span class="badge badge-pill font-weight-bold" style="background: rgba(230, 57, 70, 0.12); color: #b71c1c; padding: 0.6em 1.2em; font-size:0.8rem;"><i class="fa fa-times mr-1"></i> Declined</span>
                                }
                            </td>
                            <td>
                                <div class="font-weight-600" style="font-size:0.9rem;">@request.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted mt-1">@request.RequestedAt.ToLocalTime().ToString("hh:mm tt")</div>
                            </td>
                            <td class="text-center">
                                @if (request.Status == ServiceRentalRequestStatus.Pending)
                                {
                                    <div class="item-action dropdown">
                                        <a href="javascript:void(0)" data-toggle="dropdown" class="icon" style="color:#1e3c72; font-size:1.1rem;"><i class="fa fa-ellipsis-v"></i></a>
                                        <div class="dropdown-menu dropdown-menu-right p-3" style="min-width: 220px; border-radius:12px; box-shadow: 0 10px 25px rgba(0,0,0,0.08);">
                                            <form asp-action="Accept" method="post" class="mb-2">
                                                <input type="hidden" name="id" value="@request.Id" />
                                                <input name="responseComment" class="form-control form-control-sm mb-2 border-0 bg-light" placeholder="Optional reply" style="border-radius:6px;" />
                                                <button type="submit" class="btn btn-sm btn-block text-white" style="background:#11998e; border:none; border-radius:10px; font-weight:600;"><i class="fa fa-check"></i> Accept</button>
                                            </form>
                                            <div class="dropdown-divider"></div>
                                            <form asp-action="Decline" class="mt-2">
                                                <input type="hidden" name="id" value="@request.Id" />
                                                <input name="responseComment" class="form-control form-control-sm mb-2 border-0 bg-light" placeholder="Optional reason" style="border-radius:6px;" />
                                                <button type="submit" class="btn btn-sm btn-block text-white" style="background:#e63946; border:none; border-radius:10px; font-weight:600;"><i class="fa fa-times"></i> Decline</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                                else if (request.ReviewedAt.HasValue)
                                {
                                    <div class="small text-muted" style="line-height:1.3;">
                                        Reviewed<br/><span class="font-weight-600">@request.ReviewedAt.Value.ToLocalTime().ToString("MMM dd")</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}