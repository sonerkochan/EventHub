@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Supplier.ServiceRentalRequestListViewModel>

@{
    ViewData["Title"] = "Service Requests";
    Layout = "~/Areas/Supplier/Views/Shared/_SupplierLayout.cshtml";
}

<style>
    .table-container {
        border-radius: 1rem;
        border: 1px solid #e1e8ed;
        background-color: #fff;
        overflow: hidden;
    }
    .custom-table th {
        background-color: #f4f8fc;
        color: #0078d4;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        border-bottom: 1px solid #e1e8ed;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }
    .custom-table td {
        padding-top: 1rem;
        padding-bottom: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid #f0f4f8;
    }
    .custom-table tbody tr:last-child td {
        border-bottom: none;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-envelope-paper text-primary me-2"></i> Service Requests</h3>
        <p class="text-muted mb-0">Review and manage incoming requests from organizers.</p>
    </div>
</div>

<div class="table-container shadow-sm mt-4">
    <div class="table-responsive">
        <table class="table custom-table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Service</th>
                    <th>Requester</th>
                    <th>Details</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th class="pe-4" style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            No service requests yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark mb-1">@request.ServiceName</div>
                                <span class="badge bg-light text-dark border"><i class="bi bi-tag me-1"></i>@(request.Price.HasValue ? $"€{request.Price.Value:0.00}" : "Custom")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 35px; height: 35px;">
                                        @(request.RequesterName?.FirstOrDefault().ToString() ?? "?")
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@request.RequesterName</div>
                                        @if (!string.IsNullOrWhiteSpace(request.RequesterEmail))
                                        {
                                            <a href="mailto:@request.RequesterEmail" class="small text-decoration-none"><i class="bi bi-envelope me-1"></i>@request.RequesterEmail</a>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <span class="text-muted"><i class="bi bi-chat-left-text me-1"></i> Message:</span><br />
                                    <span class="fst-italic">@(string.IsNullOrWhiteSpace(request.Message) ? "None." : request.Message)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(request.ResponseComment))
                                {
                                    <div class="small mt-1 px-2 py-1 bg-light rounded border-start border-3 border-secondary">
                                        <span class="fw-semibold">You:</span> @request.ResponseComment
                                    </div>
                                }
                            </td>
                            <td>
                                @if (request.Status == ServiceRentalRequestStatus.Pending)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50 px-2 py-1 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                }
                                else if (request.Status == ServiceRentalRequestStatus.Accepted)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-50 px-2 py-1 rounded-pill"><i class="bi bi-check-circle me-1"></i>Accepted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-50 px-2 py-1 rounded-pill"><i class="bi bi-x-circle me-1"></i>Declined</span>
                                }
                            </td>
                            <td>
                                <div class="small text-muted">
                                    <div><i class="bi bi-calendar-event me-1"></i>@request.RequestedAt.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div><i class="bi bi-clock me-1"></i>@request.RequestedAt.ToLocalTime().ToString("HH:mm")</div>
                                </div>
                            </td>
                            <td class="pe-4">
                                @if (request.Status == ServiceRentalRequestStatus.Pending)
                                {
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-success d-flex align-items-center flex-grow-1 justify-content-center" data-bs-toggle="modal" data-bs-target="#acceptRequestModal-@request.Id">
                                            <i class="bi bi-check-lg me-1"></i> Accept
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center flex-grow-1 justify-content-center" data-bs-toggle="modal" data-bs-target="#declineRequestModal-@request.Id">
                                            <i class="bi bi-x-lg me-1"></i> Decline
                                        </button>
                                    </div>

                                    <div class="modal fade text-start" id="acceptRequestModal-@request.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-check-circle-fill text-success me-2"></i> Accept Request</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Accept" method="post">
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@request.Id" />
                                                        <p class="mb-3 text-muted">You are about to accept the request for <strong class="text-dark">@request.ServiceName</strong> from <strong class="text-dark">@request.RequesterName</strong>.</p>
                                                        <div class="mb-1">
                                                            <label class="form-label fw-semibold">Reply Note (Optional)</label>
                                                            <textarea name="responseComment" class="form-control bg-light" rows="3" placeholder="Add a polite message, confirmation details, or next steps..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light border-top-0 px-4">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success px-4">Accept Request</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade text-start" id="declineRequestModal-@request.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header border-bottom-0 pb-0">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-x-circle-fill text-danger me-2"></i> Decline Request</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Decline" method="post">
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@request.Id" />
                                                        <p class="mb-3 text-muted">You are declining the request for <strong class="text-dark">@request.ServiceName</strong>. Please provide a reason to the organizer.</p>
                                                        <div class="mb-1">
                                                            <label class="form-label fw-semibold">Reason for Declining (Optional)</label>
                                                            <textarea name="responseComment" class="form-control bg-light" rows="3" placeholder="e.g., We are fully booked for this date, or the location is outside our service area..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light border-top-0 px-4">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger px-4">Decline Request</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (request.ReviewedAt.HasValue)
                                {
                                    <div class="small text-muted text-center bg-light rounded-3 p-2 border">
                                        <i class="bi bi-clock-history me-1"></i> Reviewed on<br />
                                        <span class="fw-medium text-dark">@request.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
