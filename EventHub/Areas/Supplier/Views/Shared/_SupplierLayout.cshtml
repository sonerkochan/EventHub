@using EventHub.Infrastructure.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <title>@ViewData["Title"] - EventHub Supplier</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,500,600,700&subset=latin-ext" />
    <link rel="stylesheet" href="~/lib/tabler/assets/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tabler-eventhub.css" asp-append-version="true" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --glass-bg: rgba(255, 255, 255, 0.90);
            --glass-border: rgba(0, 0, 0, 0.06);
            --glass-shadow: 0 10px 30px -5px rgba(30, 60, 114, 0.1);
            --card-hover-transform: translateY(-4px);
        }
        body { 
            font-family: 'Source Sans Pro', sans-serif;
            background-color: #f6f8fb;
        }
        .page { 
            background-image: radial-gradient(circle at 100% 0%, #f1f4f9 0%, #eef2f7 100%);
            min-height: 100vh; 
            background-attachment: fixed; 
        }
        
        .header { 
            background: var(--glass-bg);
            backdrop-filter: blur(10px); 
            border-bottom: 1px solid var(--glass-border); 
            box-shadow: 0 4px 20px rgba(30, 60, 114, 0.02);
        }
        .header.collapse {
            border-bottom: none;
            padding: 0.5rem 0 !important;
        }
        .nav-link {
            font-weight: 500;
            color: #6e7687 !important;
            border-radius: 8px !important;
            padding: 0.6rem 1.1rem !important;
            border: none !important;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
        }
        .nav-link:hover {
            background: rgba(30, 60, 114, 0.04) !important;
            color: #1e3c72 !important;
        }
        .nav-link.active { 
            color: #ffffff !important;
            background: var(--primary-gradient) !important;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.2) !important;
        }
        .nav-link i {
            font-size: 1rem;
            transition: transform 0.2s ease;
        }
        .nav-link:hover i {
            transform: translateY(-1px);
        }
        .nav-tabs { 
            border-bottom: none;
            gap: 8px;
        }
        
        .avatar { 
            background: var(--primary-gradient);
            color: #fff; 
            font-weight: 700; 
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.25);
        }
        
        .card {
            background: #ffffff;
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: var(--glass-shadow);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }
        .card:hover {
            transform: var(--card-hover-transform);
            box-shadow: 0 20px 35px -10px rgba(30, 60, 114, 0.15);
        }
        .card-status { 
            height: 4px;
            background: var(--primary-gradient); 
        }
        .bg-primary { 
            background: var(--primary-gradient) !important;
        }
        .bg-success { 
            background: var(--success-gradient) !important;
        }

        .btn-primary {
            background: var(--primary-gradient);
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(30, 60, 114, 0.25);
            transition: all 0.2s ease;
            font-weight: 600;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(30, 60, 114, 0.35);
            background: var(--primary-gradient);
            opacity: 0.95;
        }
        
        .modal-content { 
            border-radius: 20px;
            border: none; 
            box-shadow: 0 25px 50px -12px rgba(30, 60, 114, 0.25); 
            overflow: hidden;
        }
        .modal-header { 
            background: #f8fafc;
            border-bottom: 1px solid rgba(0,0,0,0.05); 
        }
        .alert { 
            border-radius: 12px;
            border: none; 
            backdrop-filter: blur(8px);
        }
        .alert-success {
            background: rgba(17, 153, 142, 0.1);
            color: #0e746a;
        }
        .alert-danger {
            background: rgba(245, 87, 108, 0.1);
            color: #bd2130;
        }

        .toast-area {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }
        .page-title {
            font-weight: 700;
            color: #1e3c72;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .stamp {
            border-radius: 12px;
        }

        .header .dropdown-menu {
            z-index: 1070 !important;
            box-shadow: 0 10px 30px rgba(30, 60, 114, 0.18) !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            margin-top: 5px;
        }

        .header:not(.collapse) {
            position: relative !important;
            z-index: 1060 !important;
        }

        .header.collapse {
            position: relative !important;
            z-index: 1040 !important;
        }

        .page-main { 
            animation: fadeIn 0.4s ease-out;
        }

        .btn-edit-service {
            background: rgba(30, 60, 114, 0.05) !important;
            color: #1e3c72 !important;
            border: none !important;
            transition: all 0.2s ease;
        }
        .btn-edit-service:hover {
            background: #1e3c72 !important;
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        .btn-delete-service {
            background: rgba(230, 57, 70, 0.05) !important;
            color: #e63946 !important;
            border: none !important;
            transition: all 0.2s ease;
        }
        .btn-delete-service:hover {
            background: #e63946 !important;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(230, 57, 70, 0.2);
        }

        .btn-edit-modern {
            background: rgba(30, 60, 114, 0.05) !important;
            color: #1e3c72 !important;
            border: none !important;
            transition: all 0.25s ease;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-edit-modern:hover {
            background: #1e3c72 !important;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.15);
        }

        .btn-delete-modern {
            background: rgba(230, 57, 70, 0.06) !important;
            color: #e63946 !important;
            border: none !important;
            transition: all 0.25s ease;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-delete-modern:hover {
            background: #e63946 !important;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(230, 57, 70, 0.2);
        }

        .mr-1_5 {
            margin-right: 6px !important;
        }

        @@media (min-width: 992px) {
            .desktop-only-controls {
                display: flex !important;
            }
            .mobile-supplier-controls {
                display: none !important;
            }
        }

        @@media (max-width: 991.98px) {
            .header .desktop-only-controls {
                display: none !important;
            }

            .header.py-4 {
                height: 75px !important;
                padding: 0 20px !important;
                display: flex !important;
                align-items: center !important;
            }

            #headerMenuCollapse {
                background: #fff !important;
                position: absolute !important;
                top: 75px !important; 
                left: 0 !important;
                right: 0 !important;
                width: 100% !important;
                border-radius: 0 0 16px 16px !important;
                box-shadow: 0 15px 25px rgba(30, 60, 114, 0.1) !important;
                border: 1px solid rgba(0, 0, 0, 0.05) !important;
                border-top: none !important;

                padding: 12px 20px !important; 
                margin: 0 !important;
                
                z-index: 9999 !important;
                display: none;
                overflow: visible !important;
            }

            .nav-tabs {
                gap: 4px !important;
            }
            .nav-link {
                display: flex !important;
                width: 100% !important;
                padding: 0.8rem 1.1rem !important;
            }

            .mobile-supplier-controls {
                display: flex !important;
                flex-direction: column !important;
                gap: 12px;
                margin-top: 12px;
                padding-top: 16px;
                border-top: 1px dashed #e2e8f0;
            }
            .mobile-supplier-controls .nav-item {
                width: 100% !important;
            }
            .mobile-supplier-controls .dropdown-menu {
                position: static !important;
                float: none !important;
                width: 100% !important;
                box-shadow: none !important;
                border: 1px solid #e2e8f0 !important;
                background: #f8fafc !important;
                margin-top: 8px !important;
                transform: none !important;
                padding: 4px !important;
            }

            .mobile-supplier-controls .dropdown-item {
                padding: 0.7rem 1rem !important;
                display: flex !important;
                align-items: center;
                gap: 8px;
                background: transparent !important;
            }
            
            .mobile-supplier-controls .dropdown-item:hover {
                background: rgba(30, 60, 114, 0.05) !important;
            }


            .header .container-fluid,
            .page-main .container-fluid {
                padding-left: 8px !important;
                padding-right: 8px !important;
                width: 100% !important;
                max-width: 100% !important;
            }

            .style-mobile-scroll {
                overflow-x: auto !important;
                overflow-y: hidden !important;
                display: block !important;
                width: 100% !important;
                -webkit-overflow-scrolling: touch;
            }

            .style-mobile-scroll table {
                min-width: 850px !important;
                width: 100% !important;
            }

            .style-mobile-scroll td, 
            .style-mobile-scroll th {
                white-space: nowrap !important;
            }

            .style-mobile-scroll .text-wrap {
                white-space: normal !important;
            }
        }

        @@keyframes fadeIn { 
            from { opacity: 0; transform: translateY(6px); } 
            to { opacity: 1; transform: translateY(0); } 
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="page-main">
            <div class="header py-4">
                <div class="container-fluid">
                    <div class="d-flex align-items-center">
                   
                        <a class="header-brand" asp-area="Supplier" asp-controller="Home" asp-action="Index" style="text-decoration: none; display: inline-flex; align-items: center;">
                            <span style="font-size: 24px; font-weight: 700; color: #1e293b; letter-spacing: -0.5px;">
                                Event<span style="color: #4facfe;">Hub</span>
                            </span>
                            <small class="text-muted ml-2" style="font-size: 14px; font-weight: 400; align-self: flex-end; margin-bottom: 8px;">Supplier</small>
                        </a>

                        <div class="d-flex order-lg-2 ml-auto align-items-center desktop-only-controls">
                            <div class="mr-3">
                                @await Html.PartialAsync("~/Views/Shared/_CurrencySelector.cshtml")
                            </div>
       
                            @if (SignInManager.IsSignedIn(User))
                            {
                                var currentUser = await UserManager.GetUserAsync(User);
                                <div class="dropdown">
                                    <a href="#" class="nav-link pr-0 leading-none" data-toggle="dropdown">
                                        <span class="avatar">@GetInitial(User.Identity?.Name)</span>
                                        <span class="ml-2 d-none d-lg-block">
                                            <span class="text-default font-weight-600">@User.Identity?.Name</span>
                                            <small class="text-muted d-block mt-1">Supplier</small>
                                        </span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right dropdown-menu-arrow">
                                        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                            <i class="dropdown-icon fa fa-user"></i> Client area
                                        </a>
                                 
                                        @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Organizer"))
                                        {
                                            <a asp-area="Organizer" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                                <i class="dropdown-icon fa fa-calendar"></i> Organizer panel
                                            </a>
                                        }
                                        <a asp-area="" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                            <i class="dropdown-icon fa fa-home"></i> Back to site
                                        </a>
                                        <form asp-area="" asp-controller="User" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="dropdown-icon fa fa-sign-out"></i> Sign out
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>

                        <a href="javascript:void(0)" class="header-toggler d-lg-none ml-auto" id="mobileMenuBtn">
                            <span class="header-toggler-icon"></span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="header collapse d-lg-flex" id="headerMenuCollapse">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-lg order-lg-first">
                            <ul class="nav nav-tabs border-0 flex-column flex-lg-row">
                                <li class="nav-item">
                                    <a asp-area="Supplier" asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home"))">
                                        <i class="fa fa-th-large mr-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Supplier" asp-controller="Services" asp-action="Index" class="nav-link @(IsActive("Services"))">
                                        <i class="fa fa-briefcase mr-1"></i> My Services
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Supplier" asp-controller="Requests" asp-action="Index" class="nav-link @(IsActive("Requests"))">
                                        <i class="fa fa-list-alt mr-1"></i> Requests
                                    </a>
                                </li>
                            </ul>

                            <div class="mobile-supplier-controls">
                                <div class="nav-item">
                                    @await Html.PartialAsync("~/Views/Shared/_CurrencySelector.cshtml")
                                </div>
                                @if (SignInManager.IsSignedIn(User))
                                {
                                    var currentUser = await UserManager.GetUserAsync(User);
                                    <div class="nav-item dropdown">
                                        <a href="#" class="nav-link d-flex align-items-center" data-toggle="dropdown">
                                            <span class="avatar">@GetInitial(User.Identity?.Name)</span>
                                            <span class="ml-2" style="color: #6e7687; font-weight: 500;">@User.Identity?.Name (Supplier)</span>
                                            <i class="fa fa-angle-down ml-auto" style="font-size:0.8rem;color:#999;"></i>
                                        </a>
                                        <div class="dropdown-menu">
                                            <a asp-area="Client" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                                <i class="fa fa-user mr-2"></i> Client area
                                            </a>
                                            @if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Organizer"))
                                            {
                                                <a asp-area="Organizer" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                                    <i class="fa fa-calendar mr-2"></i> Organizer panel
                                                </a>
                                            }
                                            <a asp-area="" asp-controller="Home" asp-action="Index" class="dropdown-item">
                                                <i class="fa fa-home mr-2"></i> Back to site
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <form asp-area="" asp-controller="User" asp-action="Logout" method="post">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="fa fa-sign-out mr-2"></i> Sign out
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="my-3 my-md-5">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createServiceModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold" style="color:#1e3c72;">Create New Service</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5">
                    <form asp-area="Supplier" asp-controller="Services" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label for="createName" class="form-label font-weight-bold text-muted small text-uppercase">Service Name</label>
                                <input type="text" id="createName" name="Name" class="form-control form-control-lg border-0 bg-light" placeholder="e.g. Premium Catering" style="border-radius:10px;" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="createPrice" class="form-label font-weight-bold text-muted small text-uppercase">Base Price (EUR)</label>
                                <div class="input-group input-group-lg" style="border-radius:10px; overflow:hidden;">
                                    <span class="input-group-prepend">
                                        <span class="input-group-text bg-light border-0"><i class="fa fa-eur text-primary"></i></span>
                                    </span>
                                    <input type="number" step="0.01" id="createPrice" name="Price" class="form-control border-0 bg-light" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="col-12 mb-3">
                                <label for="createDescription" class="form-label font-weight-bold text-muted small text-uppercase">Description</label>
                                <textarea id="createDescription" name="Description" class="form-control border-0 bg-light" rows="5" placeholder="Describe what you offer..." style="border-radius:10px; resize:none;"></textarea>
                            </div>
                        </div>
                        <div class="text-right mt-4">
                            <button type="button" class="btn btn-link text-muted font-weight-bold mr-3" data-dismiss="modal" style="text-decoration:none;">Cancel</button>
                            <button type="submit" class="btn btn-primary px-5 rounded-pill">
                                <i class="fa fa-check mr-1"></i> Create Service
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-area" id="toastArea"></div>

    <script src="~/lib/tabler/assets/js/vendors/jquery-3.2.1.min.js"></script>
    <script src="~/lib/tabler/assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="~/lib/tabler/assets/js/core.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/currency.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toggler = document.getElementById("mobileMenuBtn");
            var menu = document.getElementById("headerMenuCollapse");

            if (toggler && menu) {
                toggler.onclick = function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (menu.style.display === "block") {
                        menu.style.setProperty("display", "none", "important");
                    } else {
                        menu.style.setProperty("display", "block", "important");
                    }
                };

                document.addEventListener("click", function (e) {
                    if (!menu.contains(e.target) && !toggler.contains(e.target)) {
                        menu.style.setProperty("display", "none", "important");
                    }
                });
            }
        });
    </script>
</body>
</html>

@functions {
    string IsActive(string controller) => ViewContext.RouteData.Values["controller"]?.ToString() == controller ? "active" : "";
    string GetInitial(string? name) => string.IsNullOrWhiteSpace(name) ? "U" : name.Trim()[0].ToString().ToUpperInvariant();
}