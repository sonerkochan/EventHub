@model EventHub.Core.Models.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="animate-fade-in">
    <!-- Welcome Header -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1">Welcome back, @User.Identity?.Name! 👋</h4>
        <p class="text-muted-modern mb-0">Here's what's happening with your platform today.</p>
    </div>

    <!-- Stat Cards Grid -->
    <div class="row g-4 mb-4 stagger-children">
        <!-- Total Users -->
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-card-label">Total Users</div>
                <div class="stat-card-value">@Model.TotalUsers</div>
                <div class="stat-card-change positive">
                    @if (Model.TodayRegistrations > 0)
                    {
                        <span>+@Model.TodayRegistrations today</span>
                    }
                    else
                    {
                        <span class="text-muted-modern">No new registrations today</span>
                    }
                </div>
            </div>
        </div>

        <!-- Total Events -->
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-card-label">Total Events</div>
                <div class="stat-card-value">@Model.TotalEvents</div>
                <div class="stat-card-change">
                    <span class="text-muted-modern">@Model.PublishedEvents published</span>
                </div>
            </div>
        </div>

        <!-- Tickets Sold -->
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-card-label">Tickets Sold</div>
                <div class="stat-card-value">@Model.TotalTicketsSold</div>
                <div class="stat-card-change positive">
                    <span>All time</span>
                </div>
            </div>
        </div>

        <!-- Revenue -->
        <div class="col-md-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-card-label">Total Revenue</div>
                <div class="stat-card-value">$@Model.TotalRevenue.ToString("N2")</div>
                <div class="stat-card-change">
                    <span class="text-muted-modern">@Model.ActiveVenues active venues</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Alerts -->
    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Quick Actions -->
            <div class="modern-card mb-4">
                <div class="modern-card-header">
                    <h6 class="mb-0 fw-semibold">Quick Actions</h6>
                </div>
                <div class="modern-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a asp-controller="Events" asp-action="Create" 
                               class="text-decoration-none d-block p-3 rounded-modern border-modern hover-lift"
                               style="transition: all 0.3s;">
                                <div style="font-size: 32px; margin-bottom: 0.5rem;">➕</div>
                                <div class="fw-medium small">Create Event</div>
                                <div style="font-size: 0.75rem; color: hsl(var(--muted-foreground));">Add new event</div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Venues" asp-action="Create" 
                               class="text-decoration-none d-block p-3 rounded-modern border-modern hover-lift"
                               style="transition: all 0.3s;">
                                <div style="font-size: 32px; margin-bottom: 0.5rem;">🏛️</div>
                                <div class="fw-medium small">Add Venue</div>
                                <div style="font-size: 0.75rem; color: hsl(var(--muted-foreground));">New location</div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Users" asp-action="Index" 
                               class="text-decoration-none d-block p-3 rounded-modern border-modern hover-lift"
                               style="transition: all 0.3s;">
                                <div style="font-size: 32px; margin-bottom: 0.5rem;">👥</div>
                                <div class="fw-medium small">Manage Users</div>
                                <div style="font-size: 0.75rem; color: hsl(var(--muted-foreground));">View all users</div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Pending Items -->
            <div class="modern-card">
                <div class="modern-card-header">
                    <h6 class="mb-0 fw-semibold">Pending Items</h6>
                </div>
                <div class="modern-card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-modern" 
                         style="background: hsl(var(--muted));">
                        <div>
                            <div class="fw-medium small">Applications</div>
                            <div style="font-size: 0.75rem; color: hsl(var(--muted-foreground));">Awaiting review</div>
                        </div>
                        <div class="badge-modern badge-modern-default" style="font-size: 1rem; padding: 0.5rem 0.75rem;">
                            @Model.PendingApplications
                        </div>
                    </div>

                    @if (Model.PendingApplications > 0)
                    {
                        <a asp-controller="Application" asp-action="Index" class="btn-modern btn-modern-primary w-100">
                            Review Applications →
                        </a>
                    }
                    else
                    {
                        <div class="text-center text-muted-modern small">All caught up! 🎉</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
</style>