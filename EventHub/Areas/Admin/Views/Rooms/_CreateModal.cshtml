@model EventHub.Core.Models.Room.AddRoomViewModel
@using EventHub.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<AdminResource> AdminLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<EnumResource> EnumLocalizer

<form asp-action="Create" method="post" onsubmit="return submitModalForm(this)">
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h6 class="modal-title fw-semibold">@AdminLocalizer["Admin.Rooms.NewRoom"]</h6>
        <button type="button" class="btn-close" data-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label small fw-medium">@AdminLocalizer["Admin.Rooms.Name"]</label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label small fw-medium">@AdminLocalizer["Admin.Rooms.Description"]</label>
            <textarea asp-for="Description" class="form-control form-control-sm" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="VenueId" class="form-label small fw-medium">@AdminLocalizer["Admin.Rooms.Venue"]</label>
            <select asp-for="VenueId" asp-items="@ViewBag.Venues" class="form-select form-select-sm">
                <option value="">@AdminLocalizer["Admin.Rooms.SelectVenue"]</option>
            </select>
            <span asp-validation-for="VenueId" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col">
                <label asp-for="Capacity" class="form-label small fw-medium">@AdminLocalizer["Admin.Rooms.Capacity"]</label>
                <input asp-for="Capacity" class="form-control form-control-sm" type="number" min="1" />
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="col">
                <label asp-for="RoomType" class="form-label small fw-medium">@AdminLocalizer["Admin.Rooms.Type"]</label>
                <select asp-for="RoomType"
                        asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.RoomType>(EnumLocalizer)"
                        class="form-select form-select-sm"></select>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">@AdminLocalizer["Admin.Common.Cancel"]</button>
        <button type="submit" class="btn btn-dark btn-sm">@AdminLocalizer["Admin.Rooms.CreateRoom"]</button>
    </div>
</form>
