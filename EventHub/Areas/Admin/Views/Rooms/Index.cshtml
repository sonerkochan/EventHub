@using EventHub.Infrastructure.Data.Models
@using EventHub.Localization
@model IEnumerable<EventHub.Core.Models.Room.RoomListViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<AdminResource> AdminLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<EnumResource> EnumLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<JsResource> JsLocalizer
@{
    ViewData["Title"] = AdminLocalizer["Admin.Rooms.Title"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">@AdminLocalizer["Admin.Rooms.Title"]</h5>
    <button class="btn btn-dark btn-sm" onclick="openModal('@Url.Action("CreatePartial")')">+ @AdminLocalizer["Admin.Rooms.NewRoom"]</button>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">@AdminLocalizer["Admin.Rooms.Name"]</th>
                    <th class="small">@AdminLocalizer["Admin.Rooms.Venue"]</th>
                    <th class="small">@AdminLocalizer["Admin.Rooms.Type"]</th>
                    <th class="small">@AdminLocalizer["Admin.Rooms.Capacity"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td class="small">@room.Name</td>
                        <td class="small text-muted">@room.VenueName</td>
                        <td><span class="badge bg-secondary fw-normal">@EnumLocalizer.LocalizeEnum(room.RoomType)</span></td>
                        <td class="small">@room.Capacity</td>
                        <td class="text-end">
                            <a asp-action="Layout" asp-route-id="@room.Id"
                               class="btn btn-outline-primary btn-sm">@AdminLocalizer["Admin.Rooms.Layout"]</a>
                            <button class="btn btn-outline-secondary btn-sm"
                                    onclick="openModal('@Url.Action("EditPartial", new { id = room.Id })')">
                                @AdminLocalizer["Admin.Rooms.Edit"]
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    onclick="deactivateRoom('@Url.Action("Deactivate", new { id = room.Id })')">
                                @AdminLocalizer["Admin.Rooms.Deactivate"]
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted small py-4">@AdminLocalizer["Admin.Rooms.NoRooms"]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal container -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="roomModalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('roomModal');
        const modal = new bootstrap.Modal(modalEl);
        const i18n = {
            deactivateRoom: '@JavaScriptEncoder.Default.Encode(JsLocalizer["Js.Confirm.DeactivateRoom"].Value)'
        };

        function openModal(url) {
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('roomModalContent').innerHTML = html;
                    modal.show();
                });
        }

        function deactivateRoom(url) {
            if (!confirm(i18n.deactivateRoom)) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];

            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
            });
        }

        function submitModalForm(form) {
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(r => {
                const ct = r.headers.get('content-type') || '';
                if (ct.includes('application/json')) return r.json();
                return r.text().then(html => ({ html }));
            })
            .then(result => {
                if (result.success) {
                    modal.hide();
                    location.reload();
                } else if (result.html) {
                    document.getElementById('roomModalContent').innerHTML = result.html;
                }
            });

            return false;
        }
    </script>
}

@Html.AntiForgeryToken()
