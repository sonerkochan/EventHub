@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Room.SeatLayoutEditorViewModel
@{
    ViewData["Title"] = $"Layout — {Model.RoomName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="fw-semibold mb-0">@Model.RoomName</h5>
        <small class="text-muted">Layout Editor</small>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span id="capacityBadge" class="capacity-badge">0 / @Model.RoomCapacity seats</span>
        <div class="mode-toggle" role="group" aria-label="Editor mode">
            <button type="button" class="btn btn-sm active" id="btnModeSeats" onclick="setMode('seats')">Seats Mode</button>
            <button type="button" class="btn btn-sm" id="btnModeZones" onclick="setMode('zones')">Zones Mode</button>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Rooms</a>
    </div>
</div>

<div id="dirtyBanner" class="alert alert-warning dirty-banner d-flex justify-content-between align-items-center gap-3 py-2" hidden>
    <span class="small mb-0">You have unsaved seat changes.</span>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" onclick="discardChanges()">Discard</button>
        <button class="btn btn-sm btn-dark" onclick="saveLayout()">Save</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-9">
        <!-- Seats mode controls -->
        <div id="seatsControls" class="card border mb-3">
            <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-medium mb-0">Rows</label>
                    <input type="number" id="gridRows" value="@Model.GridRows" min="1" max="50" class="form-control form-control-sm" style="width:70px" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-medium mb-0">Cols</label>
                    <input type="number" id="gridCols" value="@Model.GridColumns" min="1" max="50" class="form-control form-control-sm" style="width:70px" />
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="resizeGrid()">Resize</button>
                <button class="btn btn-outline-success btn-sm" onclick="fillAll()">Fill All</button>
                <button class="btn btn-outline-danger btn-sm" onclick="clearAll()">Clear All</button>
                <div class="vr"></div>
                <button id="btnSaveSeats" class="btn btn-dark btn-sm" onclick="saveLayout()" disabled>Save Seats</button>
                <button id="btnDiscardSeats" class="btn btn-outline-secondary btn-sm" onclick="discardChanges()" disabled>Discard</button>
            </div>
        </div>

        <!-- Zones mode info bar -->
        <div id="zonesControls" class="card border mb-3" hidden>
            <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
                <span class="small text-muted">Click seats to select them, pick a zone on the right, then Assign.</span>
                <div class="vr"></div>
                <span id="selectionStatus" class="small text-muted">0 selected</span>
            </div>
        </div>

        <!-- Grid -->
        <div class="card border">
            <div class="card-body seat-grid-wrap">
                <div id="seatGrid" class="seat-grid"></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-3 layout-side">
        <!-- Zones panel (zones mode only) -->
        <div id="zonePanel" class="card border mb-3" hidden>
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <span class="small fw-semibold">Zones</span>
                <button class="btn btn-dark btn-sm" onclick="showCreateZone()">+ Zone</button>
            </div>
            <div class="card-body p-0">
                <div id="createZoneForm" class="p-3 border-bottom" style="display:none">
                    <div class="mb-2">
                        <input type="text" id="newZoneName" class="form-control form-control-sm" placeholder="Zone name" />
                    </div>
                    <div class="mb-2">
                        <select id="newZoneType" class="form-select form-select-sm">
                            <option value="0">VIP</option>
                            <option value="1">Regular</option>
                            <option value="2">Economy</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark btn-sm flex-grow-1" onclick="createZone()">Create</button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="hideCreateZone()">Cancel</button>
                    </div>
                </div>
                <div id="zoneList"></div>
                <div id="zoneActions" class="p-3 border-top" hidden>
                    <div id="noZoneHint" class="small text-muted mb-2" hidden>Pick a zone above to assign selected seats.</div>
                    <button id="btnAssignSelected" class="btn btn-outline-primary btn-sm w-100 mb-2" onclick="assignSelected()" disabled>Assign selected seats</button>
                    <button class="btn btn-outline-secondary btn-sm w-100" onclick="removeFromZone()">Remove from zone</button>
                </div>
            </div>
        </div>

        <!-- Legend (always) -->
        <div class="card border">
            <div class="card-body py-2">
                <div class="small fw-semibold mb-2">Legend</div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div style="width:18px;height:18px;background:#dee2e6;border:1px solid #adb5bd;border-radius:3px"></div>
                    <span class="small text-muted">Empty cell</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div style="width:18px;height:18px;background:#212529;border-radius:3px"></div>
                    <span class="small text-muted">Seat (no zone)</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div style="width:18px;height:18px;background:#dc3545;border-radius:3px"></div>
                    <span class="small text-muted">VIP</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div style="width:18px;height:18px;background:#0d6efd;border-radius:3px"></div>
                    <span class="small text-muted">Regular</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div style="width:18px;height:18px;background:#198754;border-radius:3px"></div>
                    <span class="small text-muted">Economy</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div style="width:18px;height:18px;background:repeating-linear-gradient(45deg,#dc3545,#dc3545 4px,#b02a37 4px,#b02a37 8px);border-radius:3px"></div>
                    <span class="small text-muted">Over capacity</span>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/seat-layout.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/seat-layout.js" asp-append-version="true"></script>
    <script>
        const roomId = '@Model.RoomId';
        const roomCapacity = @Model.RoomCapacity;
        const zoneColors = { 0: '#dc3545', 1: '#0d6efd', 2: '#198754' };
        const zoneTypeNames = { 0: 'VIP', 1: 'Regular', 2: 'Economy' };

        let gridRows = @Model.GridRows;
        let gridCols = @Model.GridColumns;
        let seats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Seats, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        let zones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Zones, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        let initialSeatsSnapshot = JSON.parse(JSON.stringify(seats));
        let selectedSeatIds = new Set();
        let invalidPositions = new Set();
        let activeZoneId = null;
        let mode = 'seats';
        let isMouseDown = false;
        let paintValue = null;
        let isDirty = false;
        let insertionCounter = 0;

        function setMode(next) {
            if (mode === next) return;
            mode = next;
            selectedSeatIds.clear();
            if (mode === 'zones') activeZoneId = null;
            document.getElementById('btnModeSeats').classList.toggle('active', mode === 'seats');
            document.getElementById('btnModeZones').classList.toggle('active', mode === 'zones');
            document.getElementById('seatsControls').hidden = mode !== 'seats';
            document.getElementById('zonesControls').hidden = mode !== 'zones';
            document.getElementById('zonePanel').hidden = mode !== 'zones';
            document.getElementById('seatGrid').classList.toggle('editor-mode-zones', mode === 'zones');
            renderGrid();
            renderZones();
        }

        function markDirty() {
            isDirty = true;
            document.getElementById('btnSaveSeats').disabled = false;
            document.getElementById('btnDiscardSeats').disabled = false;
            document.getElementById('dirtyBanner').hidden = false;
        }

        function clearDirty() {
            isDirty = false;
            document.getElementById('btnSaveSeats').disabled = true;
            document.getElementById('btnDiscardSeats').disabled = true;
            document.getElementById('dirtyBanner').hidden = true;
        }

        function recomputeInvalid() {
            invalidPositions = SeatLayout.computeInvalidPositions(seats, roomCapacity);
        }

        function renderGrid() {
            const grid = document.getElementById('seatGrid');
            grid.style.gridTemplateColumns = `repeat(${gridCols}, max-content)`;
            grid.innerHTML = '';

            const seatMap = SeatLayout.getSeatMap(seats);

            for (let r = 0; r < gridRows; r++) {
                for (let c = 0; c < gridCols; c++) {
                    const cell = document.createElement('div');
                    cell.className = 'seat-cell';
                    cell.dataset.row = r;
                    cell.dataset.col = c;

                    const key = SeatLayout.seatKey(r, c);
                    const seat = seatMap[key];
                    if (seat) {
                        cell.classList.add('seat-placed');
                        cell.textContent = seat.seatNumber;

                        const isUnsaved = !seat.id;
                        if (isUnsaved) {
                            cell.classList.add('seat-unsaved');
                            cell.title = 'Unsaved — save the layout to assign zones';
                        } else if (seat.zoneId) {
                            const zone = zones.find(z => z.id === seat.zoneId);
                            if (zone) {
                                cell.style.background = zoneColors[zone.zoneType] || '#212529';
                                cell.style.borderColor = zoneColors[zone.zoneType] || '#212529';
                            }
                        }

                        if (invalidPositions.has(key)) {
                            cell.classList.add('seat-invalid');
                        }

                        if (seat.id && selectedSeatIds.has(seat.id)) {
                            cell.classList.add('seat-selected');
                        }
                    }

                    cell.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        isMouseDown = true;
                        handleCellInteraction(r, c, true);
                    });
                    cell.addEventListener('mouseenter', () => {
                        if (isMouseDown) handleCellInteraction(r, c, false);
                    });

                    grid.appendChild(cell);
                }
            }

            updateStatus();
        }

        document.addEventListener('mouseup', () => {
            isMouseDown = false;
            paintValue = null;
        });

        function handleCellInteraction(r, c, isClick) {
            const key = SeatLayout.seatKey(r, c);
            const seatMap = SeatLayout.getSeatMap(seats);
            const existing = seatMap[key];

            if (mode === 'seats') {
                if (isClick) paintValue = !existing;
                if (paintValue && !existing) {
                    seats.push({ id: null, row: r, column: c, seatNumber: 0, zoneId: null, isActive: true, insertedAt: ++insertionCounter });
                    seats = SeatLayout.renumberSeats(seats);
                    recomputeInvalid();
                    markDirty();
                    renderGrid();
                } else if (!paintValue && existing) {
                    seats = seats.filter(s => !(s.row === r && s.column === c));
                    seats = SeatLayout.renumberSeats(seats);
                    recomputeInvalid();
                    markDirty();
                    renderGrid();
                }
            } else if (mode === 'zones' && existing && existing.id) {
                if (isClick) {
                    if (selectedSeatIds.has(existing.id)) selectedSeatIds.delete(existing.id);
                    else selectedSeatIds.add(existing.id);
                } else {
                    selectedSeatIds.add(existing.id);
                }
                renderGrid();
            }
        }

        function updateStatus() {
            const total = seats.length;
            const over = Math.max(0, total - roomCapacity);
            const badge = document.getElementById('capacityBadge');
            badge.textContent = over > 0
                ? `${total} / ${roomCapacity} — over by ${over}`
                : `${total} / ${roomCapacity} seats`;
            badge.classList.toggle('over', over > 0);

            const selStatus = document.getElementById('selectionStatus');
            if (selStatus) selStatus.textContent = `${selectedSeatIds.size} selected`;

            const actions = document.getElementById('zoneActions');
            const showActions = mode === 'zones' && selectedSeatIds.size > 0;
            if (actions) actions.hidden = !showActions;

            const assignBtn = document.getElementById('btnAssignSelected');
            if (assignBtn) assignBtn.disabled = !activeZoneId;

            const hint = document.getElementById('noZoneHint');
            if (hint) hint.hidden = !(showActions && !activeZoneId);
        }

        function resizeGrid() {
            gridRows = parseInt(document.getElementById('gridRows').value) || 10;
            gridCols = parseInt(document.getElementById('gridCols').value) || 10;
            seats = SeatLayout.filterToBounds(seats, gridRows, gridCols);
            seats = SeatLayout.renumberSeats(seats);
            recomputeInvalid();
            markDirty();
            renderGrid();
        }

        function fillAll() {
            const seatMap = SeatLayout.getSeatMap(seats);
            for (let r = 0; r < gridRows; r++) {
                for (let c = 0; c < gridCols; c++) {
                    if (!seatMap[SeatLayout.seatKey(r, c)]) {
                        seats.push({ id: null, row: r, column: c, seatNumber: 0, zoneId: null, isActive: true, insertedAt: ++insertionCounter });
                    }
                }
            }
            seats = SeatLayout.renumberSeats(seats);
            recomputeInvalid();
            markDirty();
            renderGrid();
        }

        function clearAll() {
            if (!confirm('Remove all seats?')) return;
            seats = [];
            selectedSeatIds.clear();
            recomputeInvalid();
            markDirty();
            renderGrid();
        }

        function discardChanges() {
            if (!confirm('Discard all unsaved seat changes?')) return;
            seats = JSON.parse(JSON.stringify(initialSeatsSnapshot));
            selectedSeatIds.clear();
            recomputeInvalid();
            clearDirty();
            renderGrid();
        }

        function ajaxPost(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(r => r.json());
        }

        function saveLayout() {
            const btn = document.getElementById('btnSaveSeats');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            ajaxPost('@Url.Action("SaveLayout")', {
                roomId: roomId,
                layoutName: null,
                gridRows: gridRows,
                gridColumns: gridCols,
                seats: seats
            }).then(data => {
                if (data.success) {
                    seats = data.seats;
                    zones = data.zones;
                    initialSeatsSnapshot = JSON.parse(JSON.stringify(seats));
                    selectedSeatIds.clear();
                    recomputeInvalid();
                    clearDirty();
                    renderGrid();
                    renderZones();
                } else {
                    alert(data.message || 'Failed to save layout.');
                    btn.disabled = false;
                }
                btn.textContent = 'Save Seats';
            }).catch(() => {
                btn.textContent = 'Save Seats';
                btn.disabled = false;
                alert('Failed to save layout.');
            });
        }

        function renderZones() {
            const list = document.getElementById('zoneList');
            if (zones.length === 0) {
                list.innerHTML = '<div class="p-3 text-center text-muted small">No zones yet</div>';
                return;
            }
            list.innerHTML = zones.map(z => `
                <div class="zone-item ${activeZoneId === z.id ? 'active' : ''}" onclick="selectZone('${z.id}')">
                    <div class="zone-color" style="background:${zoneColors[z.zoneType] || '#6c757d'}"></div>
                    <div class="flex-grow-1">
                        <div class="small fw-medium">${z.name}</div>
                        <div class="small text-muted">${zoneTypeNames[z.zoneType]} &middot; ${z.seatCount} seats</div>
                    </div>
                    <button class="btn btn-outline-danger btn-sm" style="font-size:0.65rem;padding:1px 6px"
                            onclick="event.stopPropagation(); deleteZone('${z.id}')">x</button>
                </div>
            `).join('');
        }

        function selectZone(id) {
            activeZoneId = activeZoneId === id ? null : id;
            renderZones();
            updateStatus();
        }

        function showCreateZone() {
            document.getElementById('createZoneForm').style.display = 'block';
            document.getElementById('newZoneName').focus();
        }

        function hideCreateZone() {
            document.getElementById('createZoneForm').style.display = 'none';
            document.getElementById('newZoneName').value = '';
        }

        function createZone() {
            const name = document.getElementById('newZoneName').value.trim();
            if (!name) return;
            const zoneType = parseInt(document.getElementById('newZoneType').value);

            ajaxPost('@Url.Action("CreateZone")', { roomId, name, zoneType })
                .then(data => {
                    if (data.success) {
                        zones.push(data.zone);
                        activeZoneId = data.zone.id;
                        hideCreateZone();
                        renderZones();
                    }
                });
        }

        function assignSelected() {
            if (!activeZoneId) { alert('Select a zone first.'); return; }
            if (selectedSeatIds.size === 0) return;

            ajaxPost('@Url.Action("AssignZone")', {
                roomId, zoneId: activeZoneId, seatIds: Array.from(selectedSeatIds)
            }).then(data => {
                if (data.success) {
                    seats = data.seats;
                    zones = data.zones;
                    initialSeatsSnapshot = JSON.parse(JSON.stringify(seats));
                    selectedSeatIds.clear();
                    recomputeInvalid();
                    renderGrid();
                    renderZones();
                }
            });
        }

        function removeFromZone() {
            if (selectedSeatIds.size === 0) return;
            ajaxPost('@Url.Action("RemoveFromZone")', {
                roomId, seatIds: Array.from(selectedSeatIds)
            }).then(data => {
                if (data.success) {
                    seats = data.seats;
                    zones = data.zones;
                    initialSeatsSnapshot = JSON.parse(JSON.stringify(seats));
                    selectedSeatIds.clear();
                    recomputeInvalid();
                    renderGrid();
                    renderZones();
                }
            });
        }

        function deleteZone(id) {
            if (!confirm('Delete this zone? Seats will be unassigned.')) return;
            ajaxPost('@Url.Action("DeleteZone")', { id })
                .then(data => {
                    if (data.success) {
                        zones = zones.filter(z => z.id !== id);
                        if (activeZoneId === id) activeZoneId = null;
                        seats.forEach(s => { if (s.zoneId === id) s.zoneId = null; });
                        renderGrid();
                        renderZones();
                    }
                });
        }

        seats = SeatLayout.renumberSeats(seats);
        initialSeatsSnapshot = JSON.parse(JSON.stringify(seats));
        recomputeInvalid();
        renderGrid();
        renderZones();
    </script>
}

@Html.AntiForgeryToken()
