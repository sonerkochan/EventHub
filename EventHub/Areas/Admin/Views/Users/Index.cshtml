@model IEnumerable<EventHub.Core.Models.User.UserListViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Users</h5>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Username</th>
                    <th class="small">Email</th>
                    <th class="small">Name</th>
                    <th class="small">Roles</th>
                    <th class="small">Status</th>
                    <th class="small">Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="@(!user.IsActive ? "table-secondary" : "")">
                        <td class="small fw-medium">@user.UserName</td>
                        <td class="small">@user.Email</td>
                        <td class="small">@user.FirstName @user.LastName</td>
                        <td class="small">
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(user.IsActive ? "success" : "secondary") fw-normal">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="small">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@user.Id"
                               class="btn btn-outline-secondary btn-sm">View</a>
                            @if (user.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@user.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Deactivate this user?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-warning btn-sm">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reactivate" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-success btn-sm">Reactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted small py-4">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>