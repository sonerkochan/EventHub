@model IEnumerable<EventHub.Core.Models.User.UserListViewModel>
@{
    ViewData["Title"] = "Users";
    var roleFilter = ViewBag.RoleFilter as string;
    var roleChips = new[] { "Client", "Organizer", "Supplier", "Moderator", "Admin" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <h5 class="fw-semibold mb-0">Users</h5>
        @if (!string.IsNullOrEmpty(roleFilter))
        {
            <span class="badge bg-dark fw-normal d-flex align-items-center gap-1">
                Role: @roleFilter
                <a asp-action="Index" class="text-white text-decoration-none" title="Clear filter" style="line-height:1">&times;</a>
            </span>
        }
    </div>
    <button class="btn btn-dark btn-sm" onclick="openModal('@Url.Action("CreatePartial")')">+ New User</button>
</div>

@if (roleFilter == "Organizer" && Model.Any())
{
    var totalEvents = Model.Sum(u => u.OrganizerEventCount);
    var totalTickets = Model.Sum(u => u.OrganizerTicketsSold);
    var totalRevenue = Model.Sum(u => u.OrganizerRevenue);
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Organizers</div><div class="fw-semibold fs-5">@Model.Count()</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Active events</div><div class="fw-semibold fs-5">@totalEvents</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Tickets sold</div><div class="fw-semibold fs-5">@totalTickets</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Revenue</div><div class="fw-semibold fs-5">@totalRevenue.ToString("0.00")</div></div></div></div>
    </div>
}
else if (roleFilter == "Supplier" && Model.Any())
{
    var totalServices = Model.Sum(u => u.SupplierServiceCount);
    var totalPending = Model.Sum(u => u.SupplierPendingRequests);
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-4"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Suppliers</div><div class="fw-semibold fs-5">@Model.Count()</div></div></div></div>
        <div class="col-6 col-md-4"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Services listed</div><div class="fw-semibold fs-5">@totalServices</div></div></div></div>
        <div class="col-6 col-md-4"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Pending requests</div><div class="fw-semibold fs-5 text-warning">@totalPending</div></div></div></div>
    </div>
}
else if (roleFilter == "Client" && Model.Any())
{
    var totalBought = Model.Sum(u => u.ClientTicketsBought);
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-4"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Clients</div><div class="fw-semibold fs-5">@Model.Count()</div></div></div></div>
        <div class="col-6 col-md-4"><div class="card border"><div class="card-body py-2"><div class="small text-muted">Tickets bought</div><div class="fw-semibold fs-5">@totalBought</div></div></div></div>
    </div>
}

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Username</th>
                    <th class="small">Email</th>
                    <th class="small">Name</th>
                    <th class="small">
                        <div class="dropdown">
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-uppercase small text-reset text-decoration-none fw-bold d-inline-flex align-items-center gap-1"
                                    data-toggle="dropdown" data-bs-toggle="dropdown" aria-expanded="false"
                                    style="letter-spacing: inherit;">
                                Roles
                                @if (!string.IsNullOrEmpty(roleFilter))
                                {
                                    <span class="badge bg-dark fw-normal ms-1">@roleFilter</span>
                                }
                                <i class="fa fa-caret-down ms-1"></i>
                            </button>
                            <div class="dropdown-menu shadow-sm" style="min-width: 200px;">
                                <h6 class="dropdown-header small text-muted">Filter by role</h6>
                                <a asp-action="Index"
                                   class="dropdown-item small d-flex justify-content-between align-items-center @(string.IsNullOrEmpty(roleFilter) ? "active" : "")">
                                    All users
                                    @if (string.IsNullOrEmpty(roleFilter)) { <i class="fa fa-check"></i> }
                                </a>
                                <div class="dropdown-divider"></div>
                                @foreach (var r in roleChips)
                                {
                                    <a asp-action="Index" asp-route-role="@r"
                                       class="dropdown-item small d-flex justify-content-between align-items-center @(roleFilter == r ? "active" : "")">
                                        @r
                                        @if (roleFilter == r) { <i class="fa fa-check"></i> }
                                    </a>
                                }
                            </div>
                        </div>
                    </th>
                    <th class="small">Activity</th>
                    <th class="small">Status</th>
                    <th class="small">Created</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="@(!user.IsActive ? "table-secondary" : "")">
                        <td class="small fw-medium">@user.UserName</td>
                        <td class="small">@user.Email</td>
                        <td class="small">@user.FirstName @user.LastName</td>
                        <td class="small">
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @if (user.Roles.Contains("Organizer"))
                            {
                                <div>@user.OrganizerEventCount events &middot; @user.OrganizerTicketsSold sold</div>
                                @if (user.OrganizerRevenue > 0)
                                {
                                    <div class="text-success">@user.OrganizerRevenue.ToString("0.00") revenue</div>
                                }
                            }
                            @if (user.Roles.Contains("Supplier"))
                            {
                                <div>@user.SupplierServiceCount services</div>
                                @if (user.SupplierPendingRequests > 0)
                                {
                                    <div class="text-warning">@user.SupplierPendingRequests pending</div>
                                }
                            }
                            @if (user.Roles.Contains("Client") && !user.Roles.Contains("Organizer") && !user.Roles.Contains("Supplier"))
                            {
                                <div>@user.ClientTicketsBought tickets bought</div>
                            }
                            @if (!user.Roles.Contains("Organizer") && !user.Roles.Contains("Supplier") && !user.Roles.Contains("Client"))
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@(user.IsActive ? "success" : "secondary") fw-normal">
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="small">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm"
                                    onclick="openModal('@Url.Action("DetailsPartial", new { id = user.Id })')">
                                View
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    onclick="openModal('@Url.Action("EditPartial", new { id = user.Id })')">
                                Edit
                            </button>
                            @if (user.IsActive)
                            {
                                <button class="btn btn-outline-warning btn-sm"
                                        onclick="postAction('@Url.Action("Deactivate", new { id = user.Id })', 'Deactivate this user?')">
                                    Deactivate
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-success btn-sm"
                                        onclick="postAction('@Url.Action("Reactivate", new { id = user.Id })', 'Reactivate this user?')">
                                    Reactivate
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted small py-4">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal container -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="userModalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('userModal');
        const modal = new bootstrap.Modal(modalEl);

        function openModal(url) {
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('userModalContent').innerHTML = html;
                    modal.show();
                });
        }

        function postAction(url, confirmText) {
            if (confirmText && !confirm(confirmText)) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];

            return fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Action failed.');
            });
        }

        const addRoleUrl = '@Url.Action("AddRole")';
        const removeRoleUrl = '@Url.Action("RemoveRole")';
        const detailsPartialUrl = '@Url.Action("DetailsPartial")';

        let detailsDirty = false;
        modalEl.addEventListener('hidden.bs.modal', () => {
            if (detailsDirty) {
                detailsDirty = false;
                location.reload();
            }
        });

        function postNoReload(url) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];
            return fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            }).then(r => r.json());
        }

        function refreshDetailsModal(userId) {
            fetch(`${detailsPartialUrl}?id=${encodeURIComponent(userId)}`)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('userModalContent').innerHTML = html;
                });
        }

        function addRole(userId) {
            const role = document.getElementById('addRoleSelect').value;
            postNoReload(`${addRoleUrl}?userId=${encodeURIComponent(userId)}&role=${encodeURIComponent(role)}`)
                .then(data => {
                    if (data.success) {
                        detailsDirty = true;
                        refreshDetailsModal(userId);
                    } else {
                        alert('Failed to add role.');
                    }
                });
        }

        function removeRole(userId, role) {
            if (!confirm(`Remove ${role} role?`)) return;
            postNoReload(`${removeRoleUrl}?userId=${encodeURIComponent(userId)}&role=${encodeURIComponent(role)}`)
                .then(data => {
                    if (data.success) {
                        detailsDirty = true;
                        refreshDetailsModal(userId);
                    } else {
                        alert('Failed to remove role.');
                    }
                });
        }

        function submitModalForm(form) {
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(r => {
                const ct = r.headers.get('content-type') || '';
                if (ct.includes('application/json')) return r.json();
                return r.text().then(html => ({ html }));
            })
            .then(result => {
                if (result.success) {
                    modal.hide();
                    location.reload();
                } else if (result.html) {
                    document.getElementById('userModalContent').innerHTML = result.html;
                }
            });

            return false;
        }
    </script>
}

@Html.AntiForgeryToken()
