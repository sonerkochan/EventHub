@model EventHub.Core.Models.User.CreateUserViewModel

<form asp-action="Create" method="post" onsubmit="return submitModalForm(this)">
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h6 class="modal-title fw-semibold">New User</h6>
        <button type="button" class="btn-close" data-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="UserName" class="form-label small fw-medium">Username</label>
                <input asp-for="UserName" class="form-control form-control-sm" autocomplete="off" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Email" class="form-label small fw-medium">Email</label>
                <input asp-for="Email" class="form-control form-control-sm" type="email" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="FirstName" class="form-label small fw-medium">First name</label>
                <input asp-for="FirstName" class="form-control form-control-sm" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="LastName" class="form-label small fw-medium">Last name</label>
                <input asp-for="LastName" class="form-control form-control-sm" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="PhoneNumber" class="form-label small fw-medium">Phone</label>
                <input asp-for="PhoneNumber" class="form-control form-control-sm" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Role" class="form-label small fw-medium">Initial role</label>
                <select asp-for="Role" class="form-select form-select-sm">
                    <option value="">(none)</option>
                    <option value="Client">Client</option>
                    <option value="Organizer">Organizer</option>
                    <option value="Supplier">Supplier</option>
                    <option value="Moderator">Moderator</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Password" class="form-label small fw-medium">Password</label>
                <input asp-for="Password" class="form-control form-control-sm" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="ConfirmPassword" class="form-label small fw-medium">Confirm password</label>
                <input asp-for="ConfirmPassword" class="form-control form-control-sm" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-dark btn-sm">Create User</button>
    </div>
</form>
