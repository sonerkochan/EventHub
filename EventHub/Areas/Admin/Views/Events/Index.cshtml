@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Event.EventListViewModel>
@{
    ViewData["Title"] = "Events";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Events</h5>
    <a asp-action="Create" class="btn-modern btn-modern-primary">
        <span>➕</span> New Event
    </a>
</div>

<div class="modern-card">
    <div class="modern-card-body p-0">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Room</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th>Tickets</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-medium">@e.EventName</td>
                        <td class="text-muted-modern">@e.RoomName</td>
                        <td>@e.EventType</td>
                        <td>
                            <span class="badge-modern bg-@StatusBadge(e.EventStatus)">@e.EventStatus</span>
                        </td>
                        <td>@e.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@e.TicketsSold / @e.TotalTickets</td>
                        <td style="text-align: right;">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Details" asp-route-id="@e.Id"
                                   class="btn-modern btn-modern-ghost" style="padding: 0.375rem 0.75rem; font-size: 0.8rem;">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@e.Id"
                                   class="btn-modern btn-modern-outline" style="padding: 0.375rem 0.75rem; font-size: 0.8rem;">
                                    Edit
                                </a>

                                @if (e.EventStatus == EventStatus.Draft)
                                {
                                    <form asp-action="Publish" asp-route-id="@e.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn-modern" style="background: #10b981; color: white; padding: 0.375rem 0.75rem; font-size: 0.8rem;">
                                            Publish
                                        </button>
                                    </form>
                                }

                                <form asp-action="Deactivate" asp-route-id="@e.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Deactivate this event?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-modern btn-modern-destructive" style="padding: 0.375rem 0.75rem; font-size: 0.8rem;">
                                        Deactivate
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div style="font-size: 48px; opacity: 0.3; margin-bottom: 1rem;">🎭</div>
                            <div class="text-muted-modern">No events yet.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string StatusBadge(EventStatus s) => s switch
    {
        EventStatus.Active => "success",
        EventStatus.Published => "info",
        EventStatus.Draft => "secondary",
        EventStatus.Cancelled => "danger",
        EventStatus.Finished => "dark",
        _ => "secondary"
    };
}