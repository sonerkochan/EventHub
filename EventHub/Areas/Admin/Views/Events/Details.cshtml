@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Event.EventDetailViewModel
@{
    ViewData["Title"] = Model.EventName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-semibold mb-1">@Model.EventName</h5>
        <span class="badge bg-secondary fw-normal">@Model.EventType</span>
        <span class="badge bg-@StatusBadge(Model.EventStatus) fw-normal ms-1">@Model.EventStatus</span>
        <span class="badge bg-warning text-dark fw-normal ms-1">@Model.EventPriority</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.CoverImageUrl))
{
    <img src="@Model.CoverImageUrl" class="rounded mb-4"
         style="max-height:220px;object-fit:cover;width:100%;max-width:680px" alt="Cover" />
}

<div class="d-flex gap-4" style="max-width: 680px;">
    <div class="flex-grow-1">
        <p class="small text-muted mb-1 fw-medium">Description</p>
        <p class="small">@(Model.Description ?? "No description provided.")</p>
    </div>

    <div class="card border" style="min-width: 260px;">
        <ul class="list-group list-group-flush small">
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">Room</span>
                <strong>@Model.RoomName</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">Start</span>
                <strong>@Model.StartDateTime.ToString("dd MMM yyyy HH:mm")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">End</span>
                <strong>@Model.EndDateTime.ToString("dd MMM yyyy HH:mm")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">Tickets</span>
                <strong>@Model.TicketsSold / @Model.TotalTickets</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">Refunds</span>
                <strong>
                    @if (Model.AllowRefunds)
                    {
                        @($"Until {Model.RefundDeadline?.ToString("dd MMM yyyy") ?? "N/A"}")
                    }
                    else
                    {

                        <text>No</text>
                    }
                </strong>
            </li>
            <li class="list-group-item d-flex justify-content-between py-2">
                <span class="text-muted">Created</span>
                <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
            </li>
        </ul>
    </div>
</div>

@functions {
    string StatusBadge(EventStatus s) => s switch
    {
        EventStatus.Active => "success",
        EventStatus.Published => "primary",
        EventStatus.Draft => "secondary",
        EventStatus.Cancelled => "danger",
        EventStatus.Finished => "dark",
        _ => "secondary"
    };
}