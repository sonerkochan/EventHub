@model EventHub.Core.Models.Event.CreateEventViewModel

<form asp-action="Create" method="post" onsubmit="return submitModalForm(this)">
    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h6 class="modal-title fw-semibold">New Event</h6>
        <button type="button" class="btn-close" data-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label small fw-medium">Event Name</label>
            <input asp-for="EventName" class="form-control form-control-sm" />
            <span asp-validation-for="EventName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label small fw-medium">Description</label>
            <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="EventType" class="form-label small fw-medium">Type</label>
                <select asp-for="EventType"
                        asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>()"
                        class="form-select form-select-sm"></select>
            </div>
            <div class="col-sm-6">
                <label asp-for="EventPriority" class="form-label small fw-medium">Priority</label>
                <select asp-for="EventPriority"
                        asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>()"
                        class="form-select form-select-sm"></select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="RoomId" class="form-label small fw-medium">Room</label>
            <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-select form-select-sm">
                <option value="">— select a room —</option>
            </select>
            <span asp-validation-for="RoomId" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="StartDateTime" class="form-label small fw-medium">Start</label>
                <input asp-for="StartDateTime" class="form-control form-control-sm" type="datetime-local" />
                <span asp-validation-for="StartDateTime" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EndDateTime" class="form-label small fw-medium">End</label>
                <input asp-for="EndDateTime" class="form-control form-control-sm" type="datetime-local" />
                <span asp-validation-for="EndDateTime" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="TotalTickets" class="form-label small fw-medium">Total Tickets</label>
                <input asp-for="TotalTickets" class="form-control form-control-sm" type="number" min="1" />
                <span asp-validation-for="TotalTickets" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="BasePrice" class="form-label small fw-medium">Ticket Price (@CurrencyOptionsAccessor.Value.BaseCurrency)</label>
                <input asp-for="BasePrice" class="form-control form-control-sm" type="number" step="0.01" min="0" placeholder="0.00" />
                <span asp-validation-for="BasePrice" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">Set to 0 for free events</small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CoverImageUrl" class="form-label small fw-medium">Cover Image URL</label>
            <input asp-for="CoverImageUrl" class="form-control form-control-sm" placeholder="https://..." />
        </div>

        <div class="mb-2">
            <h6 class="fw-semibold mb-1">Location</h6>
            <p class="text-muted small mb-0">Used for the event details map and external events API.</p>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Address" class="form-label small fw-medium">Address</label>
                <input asp-for="Address" class="form-control form-control-sm" placeholder="Street address or venue entrance" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="City" class="form-label small fw-medium">City</label>
                <input asp-for="City" class="form-control form-control-sm" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="CountryCode" class="form-label small fw-medium">Country Code</label>
                <input asp-for="CountryCode" class="form-control form-control-sm" maxlength="2" placeholder="BG" />
                <span asp-validation-for="CountryCode" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Latitude" class="form-label small fw-medium">Latitude</label>
                <input asp-for="Latitude" class="form-control form-control-sm" type="number" min="-90" max="90" step="any" />
                <span asp-validation-for="Latitude" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Longitude" class="form-label small fw-medium">Longitude</label>
                <input asp-for="Longitude" class="form-control form-control-sm" type="number" min="-180" max="180" step="any" />
                <span asp-validation-for="Longitude" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                <label class="form-check-label small" for="allowRefunds">Allow Refunds</label>
            </div>
        </div>

        <div class="mb-3" id="refundDeadlineGroup" style="display:none">
            <label asp-for="RefundDeadline" class="form-label small fw-medium">Refund Deadline</label>
            <input asp-for="RefundDeadline" class="form-control form-control-sm" type="datetime-local" />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-dark btn-sm">Create Event</button>
    </div>
</form>
