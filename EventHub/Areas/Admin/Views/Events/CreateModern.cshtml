@model EventHub.Core.Models.Event.CreateEventViewModel
@using EventHub.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<OrganizerResource> OrganizerLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<AdminResource> AdminLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<EnumResource> EnumLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<CommonResource> CommonLocalizer
@{
    ViewData["Title"] = AdminLocalizer["Admin.Events.CreateTitle"];
}

<div class="animate-fade-in" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link mb-2" style="padding: 0.375rem 0.75rem;">
            <i class="fa fa-arrow-left mr-1"></i> @AdminLocalizer["Admin.Events.BackToEvents"]
        </a>
        <h4 class="fw-bold mb-1">@AdminLocalizer["Admin.Events.CreateTitle"]</h4>
        <p class="text-muted mb-0">@AdminLocalizer["Admin.Events.CreateIntro"]</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-modern">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <!-- Event Name -->
                <div class="form-group">
                    <label asp-for="EventName" class="form-label">@OrganizerLocalizer["Organizer.Events.EventName"]</label>
                    <input asp-for="EventName" class="form-control" placeholder="Summer Music Festival 2026" />
                    <span asp-validation-for="EventName" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label asp-for="Description" class="form-label">@OrganizerLocalizer["Organizer.Events.Description"]</label>
                    <textarea asp-for="Description" class="form-control" rows="4" 
                              placeholder="Tell attendees what makes this event special..."></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="BulgarianEventName" class="form-label">@OrganizerLocalizer["Organizer.Events.BulgarianEventName"]</label>
                    <input asp-for="BulgarianEventName" class="form-control" />
                    <span asp-validation-for="BulgarianEventName" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BulgarianDescription" class="form-label">@OrganizerLocalizer["Organizer.Events.BulgarianDescription"]</label>
                    <textarea asp-for="BulgarianDescription" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="BulgarianDescription" class="text-danger small"></span>
                </div>

                <!-- Type & Priority Row -->
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="EventType" class="form-label">@OrganizerLocalizer["Organizer.Events.EventType"]</label>
                            <select asp-for="EventType"
                                    asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>(EnumLocalizer)"
                                    class="form-control custom-select"></select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="EventPriority" class="form-label">@OrganizerLocalizer["Organizer.Events.Priority"]</label>
                            <select asp-for="EventPriority"
                                    asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>(EnumLocalizer)"
                                    class="form-control custom-select"></select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="RoomId" class="form-label">@OrganizerLocalizer["Organizer.Events.RoomVenue"]</label>
                            <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-control custom-select">
                                <option value="">@OrganizerLocalizer["Organizer.Events.SelectRoom"]</option>
                            </select>
                            <span asp-validation-for="RoomId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Dates Row -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="StartDateTime" class="form-label">@OrganizerLocalizer["Organizer.Events.StartDateTime"]</label>
                            <input asp-for="StartDateTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="StartDateTime" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EndDateTime" class="form-label">@OrganizerLocalizer["Organizer.Events.EndDateTime"]</label>
                            <input asp-for="EndDateTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EndDateTime" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Tickets & Cover -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="TotalTickets" class="form-label">@OrganizerLocalizer["Organizer.Events.TotalTickets"]</label>
                            <input asp-for="TotalTickets" class="form-control" type="number" min="1" placeholder="100" />
                            <span asp-validation-for="TotalTickets" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CoverImageUrl" class="form-label">@OrganizerLocalizer["Organizer.Events.CoverImageUrl"]</label>
                            <input asp-for="CoverImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CoverPhotoUpload" class="form-label">@OrganizerLocalizer["Organizer.Events.UploadCoverPhoto"]</label>
                            <input asp-for="CoverPhotoUpload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
                            <span asp-validation-for="CoverPhotoUpload" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">@OrganizerLocalizer["Organizer.Events.UploadHint"]</small>
                        </div>
                    </div>
                </div>

                <div class="mt-3 mb-2">
                    <h5 class="fw-semibold mb-1">@OrganizerLocalizer["Organizer.Events.Location"]</h5>
                    <p class="text-muted small mb-0">@OrganizerLocalizer["Organizer.Events.LocationHint"]</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Address" class="form-label">@OrganizerLocalizer["Organizer.Events.Address"]</label>
                            <input asp-for="Address" class="form-control" placeholder="Street address or venue entrance" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="City" class="form-label">@OrganizerLocalizer["Organizer.Events.City"]</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="CountryCode" class="form-label">@OrganizerLocalizer["Organizer.Events.CountryCode"]</label>
                            <input asp-for="CountryCode" class="form-control" maxlength="2" placeholder="BG" />
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label">@OrganizerLocalizer["Organizer.Events.Latitude"]</label>
                            <input asp-for="Latitude" class="form-control" type="number" min="-90" max="90" step="any" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label">@OrganizerLocalizer["Organizer.Events.Longitude"]</label>
                            <input asp-for="Longitude" class="form-control" type="number" min="-180" max="180" step="any" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Refunds Section -->
                <div class="card" style="background: hsl(var(--muted)); border: none; padding: 1.25rem;">
                    <div class="form-check mb-3">
                        <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                        <label class="form-check-label fw-medium" for="allowRefunds">
                            @OrganizerLocalizer["Organizer.Events.AllowRefunds"]
                        </label>
                    </div>

                    <div id="refundDeadlineGroup" style="display:none">
                        <div class="form-group mb-0">
                            <label asp-for="RefundDeadline" class="form-label">@OrganizerLocalizer["Organizer.Events.RefundDeadline"]</label>
                            <input asp-for="RefundDeadline" class="form-control" type="datetime-local" />
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" style="padding: 0.625rem 2rem;">
                        @OrganizerLocalizer["Organizer.Events.CreateButton"]
                    </button>
                    <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 2rem;">
                        @CommonLocalizer["Common.Cancel"]
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const cb = document.getElementById('allowRefunds');
        const group = document.getElementById('refundDeadlineGroup');
        const toggle = () => {
            if (cb.checked) {
                group.style.display = 'block';
                group.style.animation = 'fadeIn 0.3s ease-out';
            } else {
                group.style.display = 'none';
            }
        };
        cb.addEventListener('change', toggle);
        toggle();
    </script>
}
