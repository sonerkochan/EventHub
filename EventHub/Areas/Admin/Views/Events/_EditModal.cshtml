@model EventHub.Core.Models.Event.EditEventViewModel
@inject IStringLocalizer<OrganizerResource> OrganizerLocalizer
@inject IStringLocalizer<EnumResource> EnumLocalizer
@inject IStringLocalizer<CommonResource> CommonLocalizer

<form asp-action="Edit" method="post" enctype="multipart/form-data" onsubmit="return submitModalForm(this)">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="CoverPhotoId" type="hidden" />

    <div class="modal-header">
        <h6 class="modal-title fw-semibold">@OrganizerLocalizer["Organizer.Events.EditTitle"]</h6>
        <button type="button" class="btn-close" data-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.EventName"]</label>
            <input asp-for="EventName" class="form-control form-control-sm" />
            <span asp-validation-for="EventName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Description"]</label>
            <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="BulgarianEventName" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.BulgarianEventName"]</label>
            <input asp-for="BulgarianEventName" class="form-control form-control-sm" />
            <span asp-validation-for="BulgarianEventName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BulgarianDescription" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.BulgarianDescription"]</label>
            <textarea asp-for="BulgarianDescription" class="form-control form-control-sm" rows="3"></textarea>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <label asp-for="EventType" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Type"]</label>
                <select asp-for="EventType"
                        asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>(EnumLocalizer)"
                        class="form-select form-select-sm"></select>
            </div>
            <div class="col-sm-4">
                <label asp-for="EventStatus" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Status"]</label>
                <select asp-for="EventStatus"
                        asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.EventStatus>(EnumLocalizer)"
                        class="form-select form-select-sm"></select>
            </div>
            <div class="col-sm-4">
                <label asp-for="EventPriority" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Priority"]</label>
                <select asp-for="EventPriority"
                        asp-items="Html.LocalizedEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>(EnumLocalizer)"
                        class="form-select form-select-sm"></select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="RoomId" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Room"]</label>
            <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-select form-select-sm"></select>
            <span asp-validation-for="RoomId" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="StartDateTime" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Start"]</label>
                <input asp-for="StartDateTime" class="form-control form-control-sm" type="datetime-local" />
            </div>
            <div class="col-sm-6">
                <label asp-for="EndDateTime" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.End"]</label>
                <input asp-for="EndDateTime" class="form-control form-control-sm" type="datetime-local" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="TotalTickets" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.TotalTickets"]</label>
                <input asp-for="TotalTickets" class="form-control form-control-sm" type="number" min="1" />
                <span asp-validation-for="TotalTickets" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="BasePrice" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.TicketPrice", CurrencyOptionsAccessor.Value.BaseCurrency]</label>
                <input asp-for="BasePrice" class="form-control form-control-sm" type="number" step="0.01" min="0" />
                <span asp-validation-for="BasePrice" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">@OrganizerLocalizer["Organizer.Events.FreeHint"]</small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CoverImageUrl" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.CoverImageUrl"]</label>
            <input asp-for="CoverImageUrl" class="form-control form-control-sm" />
            <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CoverPhotoUpload" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.UploadNewCoverPhoto"]</label>
            <input asp-for="CoverPhotoUpload" class="form-control form-control-sm" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
            <span asp-validation-for="CoverPhotoUpload" class="text-danger small"></span>
            <small class="text-muted d-block mt-1">@OrganizerLocalizer["Organizer.Events.UploadHint"]</small>
        </div>

        <div class="mb-2">
            <h6 class="fw-semibold mb-1">@OrganizerLocalizer["Organizer.Events.Location"]</h6>
            <p class="text-muted small mb-0">@OrganizerLocalizer["Organizer.Events.LocationHint"]</p>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Address" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Address"]</label>
                <input asp-for="Address" class="form-control form-control-sm" placeholder="@OrganizerLocalizer["Organizer.Events.AddressPlaceholder"]" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="City" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.City"]</label>
                <input asp-for="City" class="form-control form-control-sm" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="CountryCode" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.CountryCode"]</label>
                <input asp-for="CountryCode" class="form-control form-control-sm" maxlength="2" placeholder="BG" />
                <span asp-validation-for="CountryCode" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Latitude" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Latitude"]</label>
                <input asp-for="Latitude" class="form-control form-control-sm" type="number" min="-90" max="90" step="any" />
                <span asp-validation-for="Latitude" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Longitude" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.Longitude"]</label>
                <input asp-for="Longitude" class="form-control form-control-sm" type="number" min="-180" max="180" step="any" />
                <span asp-validation-for="Longitude" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="form-check">
                <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                <label class="form-check-label small" for="allowRefunds">@OrganizerLocalizer["Organizer.Events.AllowRefunds"]</label>
            </div>
        </div>

        <div class="mb-3" id="refundDeadlineGroup">
            <label asp-for="RefundDeadline" class="form-label small fw-medium">@OrganizerLocalizer["Organizer.Events.RefundDeadline"]</label>
            <input asp-for="RefundDeadline" class="form-control form-control-sm" type="datetime-local" />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">@CommonLocalizer["Common.Action.Cancel"]</button>
        <button type="submit" class="btn btn-dark btn-sm">@OrganizerLocalizer["Organizer.Events.SaveButton"]</button>
    </div>
</form>
