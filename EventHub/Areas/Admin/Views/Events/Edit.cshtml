@model EventHub.Core.Models.Event.EditEventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Edit Event</h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="card border" style="max-width: 680px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="EventName" class="form-label small fw-medium">Event Name</label>
                <input asp-for="EventName" class="form-control form-control-sm" />
                <span asp-validation-for="EventName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label small fw-medium">Description</label>
                <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="EventType" class="form-label small fw-medium">Type</label>
                    <select asp-for="EventType"
                            asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>()"
                            class="form-select form-select-sm"></select>
                </div>
                <div class="col">
                    <label asp-for="EventStatus" class="form-label small fw-medium">Status</label>
                    <select asp-for="EventStatus"
                            asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventStatus>()"
                            class="form-select form-select-sm"></select>
                </div>
                <div class="col">
                    <label asp-for="EventPriority" class="form-label small fw-medium">Priority</label>
                    <select asp-for="EventPriority"
                            asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>()"
                            class="form-select form-select-sm"></select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="RoomId" class="form-label small fw-medium">Room</label>
                <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-select form-select-sm"></select>
                <span asp-validation-for="RoomId" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col">
                    <label asp-for="StartDateTime" class="form-label small fw-medium">Start</label>
                    <input asp-for="StartDateTime" class="form-control form-control-sm" type="datetime-local" />
                </div>
                <div class="col">
                    <label asp-for="EndDateTime" class="form-label small fw-medium">End</label>
                    <input asp-for="EndDateTime" class="form-control form-control-sm" type="datetime-local" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="TotalTickets" class="form-label small fw-medium">Total Tickets</label>
                <input asp-for="TotalTickets" class="form-control form-control-sm" type="number" min="1" />
                <span asp-validation-for="TotalTickets" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BasePrice" class="form-label small fw-medium">Ticket Price (USD)</label>
                <input asp-for="BasePrice" class="form-control form-control-sm" type="number" step="0.01" min="0" />
                <span asp-validation-for="BasePrice" class="text-danger small"></span>
                <small class="text-muted d-block mt-1">Set to 0 for free events</small>
            </div>

            <div class="mb-3">
                <label asp-for="CoverImageUrl" class="form-label small fw-medium">Cover Image URL</label>
                <input asp-for="CoverImageUrl" class="form-control form-control-sm" />
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                    <label class="form-check-label small" for="allowRefunds">Allow Refunds</label>
                </div>
            </div>

            <div class="mb-4" id="refundDeadlineGroup">
                <label asp-for="RefundDeadline" class="form-label small fw-medium">Refund Deadline</label>
                <input asp-for="RefundDeadline" class="form-control form-control-sm" type="datetime-local" />
            </div>

            <button type="submit" class="btn btn-dark btn-sm w-100">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const cb = document.getElementById('allowRefunds');
        const group = document.getElementById('refundDeadlineGroup');
        const toggle = () => group.style.display = cb.checked ? 'block' : 'none';
        cb.addEventListener('change', toggle);
        toggle();
    </script>
}