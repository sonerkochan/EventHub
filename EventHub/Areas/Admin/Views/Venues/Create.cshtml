@model EventHub.Core.Models.Venue.AddVenueViewModel

@{
    ViewData["Title"] = "Create Venue";
}

<h2>Create Venue</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Country"></label>
        <input asp-for="Country" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="PostalCode"></label>
        <input asp-for="PostalCode" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Latitude"></label>
        <input asp-for="Latitude" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Longitude"></label>
        <input asp-for="Longitude" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="ContactEmail"></label>
        <input asp-for="ContactEmail" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="ContactPhone"></label>
        <input asp-for="ContactPhone" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success mt-2">Create</button>
    <a asp-action="All" class="btn btn-secondary mt-2">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}