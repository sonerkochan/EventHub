@model IEnumerable<EventHub.Core.Models.Venue.VenueListViewModel>
@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Venues</h5>
    <button class="btn btn-dark btn-sm" onclick="openModal('@Url.Action("CreatePartial")')">+ New Venue</button>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Name</th>
                    <th class="small">City</th>
                    <th class="small">Country</th>
                    <th class="small">Address</th>
                    <th class="small">Coordinates</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venue in Model)
                {
                    <tr>
                        <td class="small">@venue.Name</td>
                        <td class="small text-muted">@venue.City</td>
                        <td class="small text-muted">@venue.Country</td>
                        <td class="small text-muted">@venue.Address</td>
                        <td class="small text-muted">@venue.Latitude, @venue.Longitude</td>
                        <td class="text-end">
                            <button class="btn btn-outline-secondary btn-sm"
                                    onclick="openModal('@Url.Action("EditPartial", new { id = venue.Id })')">
                                Edit
                            </button>
                            <button class="btn btn-outline-danger btn-sm"
                                    onclick="deactivateVenue('@Url.Action("Deactivate", new { id = venue.Id })')">
                                Deactivate
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted small py-4">No venues yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal container -->
<div class="modal fade" id="venueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="venueModalContent">
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="~/js/venus-create-modal.js"></script>
    <script>
        const modalEl = document.getElementById('venueModal');
        const modal = new bootstrap.Modal(modalEl);

        function openModal(url) {
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('venueModalContent').innerHTML = html;
                    modal.show();
                });
        }

        function deactivateVenue(url) {
            if (!confirm('Deactivate this venue?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];

            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) location.reload();
            });
        }

        function submitModalForm(form) {
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(r => {
                const ct = r.headers.get('content-type') || '';
                if (ct.includes('application/json')) return r.json();
                return r.text().then(html => ({ html }));
            })
            .then(result => {
                if (result.success) {
                    modal.hide();
                    location.reload();
                } else if (result.html) {
                    document.getElementById('venueModalContent').innerHTML = result.html;
                }
            });

            return false;
        }
    </script>
}

@Html.AntiForgeryToken()
