@* Areas/Admin/Views/Moderators/Index.cshtml *@
@model IEnumerable<EventHub.Core.Models.Moderator.ModeratorListViewModel>

@{
    ViewData["Title"] = "Moderators";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Moderators</h5>
    <button class="btn btn-dark btn-sm" onclick="openModal('@Url.Action("CreatePartial")')">+ Add moderator</button>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Username</th>
                    <th class="small">Name</th>
                    <th class="small">Email</th>
                    <th class="small">Created</th>
                    <th class="small">Status</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mod in Model)
                {
                    <tr class="@(!mod.IsActive ? "table-secondary" : "")">
                        <td class="small fw-medium">@mod.Username</td>
                        <td class="small">@mod.FirstName @mod.LastName</td>
                        <td class="small">@mod.Email</td>
                        <td class="small">@mod.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-@(mod.IsActive ? "success" : "secondary") fw-normal">
                                @(mod.IsActive ? "Active" : "Disabled")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-secondary btn-sm"
                                    onclick="openModal('@Url.Action("EditPartial", new { id = mod.Id })')">
                                Edit
                            </button>

                            @if (mod.IsActive)
                            {
                                <form asp-action="Disable" asp-route-id="@mod.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Disable</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Enable" asp-route-id="@mod.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success btn-sm">Enable</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted small py-4">No moderators found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal container -->
<div class="modal fade" id="moderatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="moderatorModalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEl = document.getElementById('moderatorModal');
        const modal = new bootstrap.Modal(modalEl);

        function openModal(url) {
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('moderatorModalContent').innerHTML = html;
                    modal.show();
                });
        }

        function submitModalForm(form) {
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(r => {
                const ct = r.headers.get('content-type') || '';
                if (ct.includes('application/json')) return r.json();
                return r.text().then(html => ({ html }));
            })
            .then(result => {
                if (result.success) {
                    modal.hide();
                    location.reload();
                } else if (result.html) {
                    document.getElementById('moderatorModalContent').innerHTML = result.html;
                }
            });

            return false;
        }
    </script>
}