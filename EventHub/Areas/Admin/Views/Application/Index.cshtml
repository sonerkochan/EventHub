@using EventHub.Core.Models.ApplicationForm
@model IEnumerable<ApplicationListViewModel>

@{
    ViewData["Title"] = "Applications";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-semibold mb-0">Pending Applications</h5>
    <span class="badge bg-secondary">@Model.Count() pending</span>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">User</th>
                    <th class="small">Type</th>
                    <th class="small">Organization</th>
                    <th class="small">Phone</th>
                    <th class="small">Description</th>
                    <th class="small">Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td class="small fw-medium">@app.UserName</td>
                        <td>
                            <span class="badge bg-@(app.Type.ToString() == "Organizer" ? "primary" : "info") fw-normal">
                                @app.Type
                            </span>
                        </td>
                        <td class="small">@app.OrganizationName</td>
                        <td class="small">@app.PhoneNumber</td>
                        <td class="small text-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            @app.Description
                        </td>
                        <td class="small">@app.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <form asp-action="Approve" asp-route-id="@app.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Approve this application?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-success btn-sm">Approve</button>
                            </form>

                            <button class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#reject-@app.Id">
                                Reject
                            </button>

                            <div class="collapse mt-2" id="reject-@app.Id">
                                <form asp-action="Reject" asp-route-id="@app.Id" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="text" name="comment" placeholder="Rejection reason"
                                           class="form-control form-control-sm" required />
                                    <button class="btn btn-danger btn-sm">Confirm</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted small py-4">No pending applications.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>