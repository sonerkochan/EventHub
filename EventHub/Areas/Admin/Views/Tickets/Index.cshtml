@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Admin.TicketsOverviewRow>
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-semibold mb-0">Tickets</h5>
</div>

<div class="card border mb-3">
    <div class="card-body py-2">
        <form class="d-flex flex-wrap gap-2 align-items-center mb-0" onsubmit="return lookupTicket(event)">
            <label class="small fw-medium mb-0 me-1">Find a ticket:</label>
            <input type="text" id="ticketLookupInput" class="form-control form-control-sm flex-grow-1"
                   placeholder="Ticket # (e.g. 1000007) or code (e.g. 8UAKEE8BZUVOPXVK)"
                   style="min-width: 200px; max-width: 420px;" autocomplete="off" />
            <button type="submit" class="btn btn-dark btn-sm">
                <i class="fa fa-search mr-1"></i> Look up
            </button>
        </form>
    </div>
</div>

<div class="card border">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small">Event</th>
                    <th class="small">Room</th>
                    <th class="small">Start</th>
                    <th class="small">Status</th>
                    <th class="small">Pricing</th>
                    <th class="small text-end">Sold</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var pct = r.TotalTickets > 0 ? (r.TicketsSold * 100 / r.TotalTickets) : 0;
                    <tr>
                        <td class="small fw-medium">@r.EventName</td>
                        <td class="small text-muted">@r.RoomName</td>
                        <td class="small">@r.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-@StatusBadge(r.EventStatus) fw-normal">@r.EventStatus</span>
                        </td>
                        <td>
                            @if (r.HasPricing)
                            {
                                <span class="badge bg-success fw-normal">Configured</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fw-normal">Not set</span>
                            }
                        </td>
                        <td class="small text-end">
                            @r.TicketsSold / @r.TotalTickets
                            <span class="text-muted">(@pct%)</span>
                        </td>
                        <td class="text-end">
                            @if (r.HasPricing)
                            {
                                <a asp-controller="EventTickets" asp-action="Manage" asp-route-id="@r.EventId"
                                   class="btn btn-outline-info btn-sm">Manage</a>
                            }
                            else
                            {
                                <a asp-controller="EventTickets" asp-action="Pricing" asp-route-id="@r.EventId"
                                   class="btn btn-outline-info btn-sm">Set pricing</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted small py-4">No events yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string StatusBadge(EventStatus s) => s switch
    {
        EventStatus.Active => "success",
        EventStatus.Published => "info",
        EventStatus.Draft => "secondary",
        EventStatus.Cancelled => "danger",
        EventStatus.Finished => "dark",
        _ => "secondary"
    };
}

<div class="modal fade" id="ticketLookupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="ticketLookupModalContent"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const lookupUrl = '@Url.Action("LookupPartial")';
        const refundUrl = '@Url.Action("Refund")';
        const lookupModalEl = document.getElementById('ticketLookupModal');
        const lookupModal = new bootstrap.Modal(lookupModalEl);

        function lookupTicket(e) {
            e.preventDefault();
            const query = document.getElementById('ticketLookupInput').value.trim();
            if (!query) return false;

            fetch(`${lookupUrl}?q=${encodeURIComponent(query)}`)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('ticketLookupModalContent').innerHTML = html;
                    lookupModal.show();
                });
            return false;
        }

        function refundLookupTicket(ticketId, ticketNumber) {
            if (!confirm(`Refund ticket #${ticketNumber}? This marks the ticket and payment as Refunded.`)) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const body = new URLSearchParams();
            body.append('ticketId', ticketId);
            body.append('__RequestVerificationToken', token);

            fetch(refundUrl, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    // refresh modal with updated state
                    fetch(`${lookupUrl}?q=${encodeURIComponent(ticketNumber)}`)
                        .then(r => r.text())
                        .then(html => {
                            document.getElementById('ticketLookupModalContent').innerHTML = html;
                        });
                } else {
                    alert('Refund failed.');
                }
            });
        }
    </script>
}
