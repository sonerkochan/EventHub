@model EventHub.Core.Models.Event.EditEventViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<h2>Edit Event</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="CoverPhotoId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="EventName" class="form-label"></label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="RoomId" class="form-label">Room</label>
            <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-select"></select>
            <span asp-validation-for="RoomId" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>()" class="form-select"></select>
        </div>

        <div class="col-md-3">
            <label asp-for="EventStatus" class="form-label"></label>
            <select asp-for="EventStatus" asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventStatus>()" class="form-select"></select>
        </div>

        <div class="col-md-3">
            <label asp-for="EventPriority" class="form-label"></label>
            <select asp-for="EventPriority" asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>()" class="form-select"></select>
        </div>

        <div class="col-md-3">
            <label asp-for="TotalTickets" class="form-label"></label>
            <input asp-for="TotalTickets" class="form-control" type="number" min="1" />
            <span asp-validation-for="TotalTickets" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="BasePrice" class="form-label">Ticket Price (@CurrencyOptionsAccessor.Value.BaseCurrency)</label>
            <input asp-for="BasePrice" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
            <span asp-validation-for="BasePrice" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="StartDateTime" class="form-label"></label>
            <input asp-for="StartDateTime" class="form-control" type="datetime-local" />
        </div>

        <div class="col-md-3">
            <label asp-for="EndDateTime" class="form-label"></label>
            <input asp-for="EndDateTime" class="form-control" type="datetime-local" />
        </div>

        <div class="col-md-4">
            <div class="form-check mt-4">
                <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                <label class="form-check-label" for="allowRefunds">Allow Refunds</label>
            </div>
        </div>

        <div class="col-md-4" id="refundDeadlineGroup">
            <label asp-for="RefundDeadline" class="form-label"></label>
            <input asp-for="RefundDeadline" class="form-control" type="datetime-local" />
        </div>

        <div class="col-md-8">
            <label asp-for="CoverImageUrl" class="form-label">Cover Image URL</label>
            <input asp-for="CoverImageUrl" class="form-control" />
            <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CoverPhotoUpload" class="form-label">Upload New Cover Photo</label>
            <input asp-for="CoverPhotoUpload" class="form-control" type="file" accept="image/jpeg,image/png,image/webp,image/heic" />
            <span asp-validation-for="CoverPhotoUpload" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Uploaded photo is used instead of the URL.</small>
        </div>

        <div class="col-12">
            <h5 class="fw-semibold mt-3 mb-0">Location</h5>
            <p class="text-muted small mb-0">Used for the event details map and external events API.</p>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label">Address</label>
            <input asp-for="Address" class="form-control" placeholder="Street address or venue entrance" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="CountryCode" class="form-label">Country Code</label>
            <input asp-for="CountryCode" class="form-control" maxlength="2" placeholder="BG" />
            <span asp-validation-for="CountryCode" class="text-danger"></span>
        </div>
        
        <div class="col-12">
            <label class="form-label">Pick Location on Map</label>
            <div id="locationMap" style="height:350px; border-radius:8px; border:1px solid #dee2e6;"></div>
            <small class="text-muted">Click the map to place a pin and fill in coordinates automatically.</small>
        </div>

        <div class="col-md-3">
            <label asp-for="Latitude" class="form-label">Latitude</label>
            <input asp-for="Latitude" id="latInput" class="form-control" type="number" min="-90" max="90" step="any" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Longitude" class="form-label">Longitude</label>
            <input asp-for="Longitude" id="lngInput" class="form-control" type="number" min="-180" max="180" step="any" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const cb = document.getElementById('allowRefunds');
        const group = document.getElementById('refundDeadlineGroup');
        const toggle = () => group.style.display = cb.checked ? 'block' : 'none';
        cb.addEventListener('change', toggle);
        toggle();
    </script>
    <script>
        // MAP PICKER
        const latInput = document.getElementById('latInput');
        const lngInput = document.getElementById('lngInput');

        const defaultLat = parseFloat(latInput.value) || 42.7;
        const defaultLng = parseFloat(lngInput.value) || 25.5; // centres on Bulgaria

        const map = L.map('locationMap').setView([defaultLat, defaultLng], 7);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // If coords already writen by user ->> show the pin immediately
        let marker = null;
        if (latInput.value && lngInput.value) {
        marker = L.marker([defaultLat, defaultLng]).addTo(map);
        }

        // Click map -> drop/move pin then fill inputs
        map.on('click', (e) => {
        const { lat, lng } = e.latlng;
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);

        if (marker) {
        marker.setLatLng(e.latlng);
        } else {
        marker = L.marker(e.latlng).addTo(map);
        }
        });

        // Typing in inputs -> movess pin
        function syncMapFromInputs() {
        const lat = parseFloat(latInput.value);
        const lng = parseFloat(lngInput.value);
        if (isNaN(lat) || isNaN(lng)) return;
        const latlng = [lat, lng];
        if (marker) {
        marker.setLatLng(latlng);
        } else {
        marker = L.marker(latlng).addTo(map);
        }
        map.panTo(latlng);
        }

        latInput.addEventListener('change', syncMapFromInputs);
        lngInput.addEventListener('change', syncMapFromInputs);
    </script>
}
