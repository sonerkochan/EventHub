@using EventHub.Infrastructure.Data.Models
@model IEnumerable<EventHub.Core.Models.Event.EventListViewModel>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Events</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Event</a>
</div>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Room</th>
            <th>Type</th>
            <th>Status</th>
            <th>Start</th>
            <th>Tickets Sold</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.EventName</td>
                <td>@e.RoomName</td>
                <td>@e.EventType</td>
                <td>
                    <span class="badge bg-@StatusBadge(e.EventStatus)">@e.EventStatus</span>
                </td>
                <td>@e.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                <td>@e.TicketsSold / @e.TotalTickets</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">View</a>
                    <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Deactivate" asp-route-id="@e.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Deactivate this event?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    string StatusBadge(EventStatus s) => s switch
    {
        EventStatus.Active => "success",
        EventStatus.Published => "info",
        EventStatus.Draft => "secondary",
        EventStatus.Cancelled => "danger",
        EventStatus.Finished => "dark",
        _ => "secondary"
    };
}