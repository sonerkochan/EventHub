@model EventHub.Core.Models.Event.EventDetailViewModel
@{
    ViewData["Title"] = Model.EventName;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2>@Model.EventName</h2>
        <span class="badge bg-secondary">@Model.EventType</span>
        <span class="badge bg-primary ms-1">@Model.EventStatus</span>
        <span class="badge bg-warning text-dark ms-1">@Model.EventPriority</span>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.CoverImageDisplayUrl))
{
    <img src="@Model.CoverImageDisplayUrl" class="img-fluid rounded mb-4" alt="@Model.EventName" style="max-height:300px;object-fit:cover;width:100%" />
}

<div class="row g-4">
    <div class="col-md-8">
        <h5>Description</h5>
        <p>@(Model.Description ?? "No description provided.")</p>
    </div>
    <div class="col-md-4">
        <ul class="list-group">
            <li class="list-group-item d-flex justify-content-between">
                <span>Room</span><strong>@Model.RoomName</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span>Start</span><strong>@Model.StartDateTime.ToString("dd MMM yyyy HH:mm")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span>End</span><strong>@Model.EndDateTime.ToString("dd MMM yyyy HH:mm")</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span>Tickets</span><strong>@Model.TicketsSold / @Model.TotalTickets sold</strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span>Refunds</span>
                <strong>
                    @if (Model.AllowRefunds)
                    {
                        @($"Yes — until {Model.RefundDeadline?.ToString("dd MMM yyyy") ?? "N/A"}")
                    }
                    else
                    {
                        <text>No</text>
                    }
                </strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
                <span>Created</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
            </li>
        </ul>
    </div>
</div>
