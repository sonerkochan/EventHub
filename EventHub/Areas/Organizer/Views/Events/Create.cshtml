@model EventHub.Core.Models.Event.CreateEventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<h2>Create Event</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="EventName" class="form-label"></label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="RoomId" class="form-label">Room</label>
            <select asp-for="RoomId" asp-items="Model.AvailableRooms" class="form-select">
                <option value="">— select a room —</option>
            </select>
            <span asp-validation-for="RoomId" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-4">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventType>()" class="form-select"></select>
        </div>

        <div class="col-md-4">
            <label asp-for="EventPriority" class="form-label"></label>
            <select asp-for="EventPriority" asp-items="Html.GetEnumSelectList<EventHub.Infrastructure.Data.Models.EventPriority>()" class="form-select"></select>
        </div>

        <div class="col-md-3">
            <label asp-for="TotalTickets" class="form-label"></label>
            <input asp-for="TotalTickets" class="form-control" type="number" min="1" />
            <span asp-validation-for="TotalTickets" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="BasePrice" class="form-label">Ticket Price (@CurrencyOptionsAccessor.Value.BaseCurrency)</label>
            <input asp-for="BasePrice" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
            <span asp-validation-for="BasePrice" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="StartDateTime" class="form-label"></label>
            <input asp-for="StartDateTime" class="form-control" type="datetime-local" />
            <span asp-validation-for="StartDateTime" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EndDateTime" class="form-label"></label>
            <input asp-for="EndDateTime" class="form-control" type="datetime-local" />
            <span asp-validation-for="EndDateTime" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <div class="form-check mt-4">
                <input asp-for="AllowRefunds" class="form-check-input" type="checkbox" id="allowRefunds" />
                <label class="form-check-label" for="allowRefunds">Allow Refunds</label>
            </div>
        </div>

        <div class="col-md-4" id="refundDeadlineGroup" style="display:none">
            <label asp-for="RefundDeadline" class="form-label"></label>
            <input asp-for="RefundDeadline" class="form-control" type="datetime-local" />
        </div>

        <div class="col-md-8">
            <label asp-for="CoverImageUrl" class="form-label">Cover Image URL</label>
            <input asp-for="CoverImageUrl" class="form-control" placeholder="https://..." />
            <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CoverPhotoUpload" class="form-label">Upload Cover Photo</label>
            <input asp-for="CoverPhotoUpload" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/heic" />
            <span asp-validation-for="CoverPhotoUpload" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Uploaded photo is used instead of the URL.</small>
        </div>

        <div class="col-12">
            <h5 class="fw-semibold mt-3 mb-0">Location</h5>
            <p class="text-muted small mb-0">Used for the event details map and external events API.</p>
        </div>

        <div class="col-md-6">
            <label asp-for="Address" class="form-label">Address</label>
            <input asp-for="Address" class="form-control" placeholder="Street address or venue entrance" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="CountryCode" class="form-label">Country Code</label>
            <input asp-for="CountryCode" class="form-control" maxlength="2" placeholder="BG" />
            <span asp-validation-for="CountryCode" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Latitude" class="form-label">Latitude</label>
            <input asp-for="Latitude" class="form-control" type="number" min="-90" max="90" step="any" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Longitude" class="form-label">Longitude</label>
            <input asp-for="Longitude" class="form-control" type="number" min="-180" max="180" step="any" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Create Event</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const cb = document.getElementById('allowRefunds');
        const group = document.getElementById('refundDeadlineGroup');
        cb.addEventListener('change', () => group.style.display = cb.checked ? 'block' : 'none');
        if (cb.checked) group.style.display = 'block';
    </script>
}
