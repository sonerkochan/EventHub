@model EventHub.Core.Models.Venue.EditVenueViewModel

<form asp-action="Edit" method="post" onsubmit="return submitModalForm(this)" id="venueForm">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="modal-header">
        <h6 class="modal-title fw-semibold">Edit Venue</h6>
        <button type="button" class="btn-close" data-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label small fw-medium">Name</label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label small fw-medium">Description</label>
            <textarea asp-for="Description" class="form-control form-control-sm" rows="2"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label small fw-medium">Address</label>
            <input asp-for="Address" class="form-control form-control-sm" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-5">
                <label asp-for="City" class="form-label small fw-medium">City</label>
                <input asp-for="City" id="cityInput" class="form-control form-control-sm" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-sm-5">
                <label asp-for="Country" class="form-label small fw-medium">Country</label>
                <input asp-for="Country" id="countryInput" class="form-control form-control-sm" />
                <span asp-validation-for="Country" class="text-danger small"></span>
            </div>
            <div class="col-sm-2">
                <label asp-for="PostalCode" class="form-label small fw-medium">Postal</label>
                <input asp-for="PostalCode" id="postalInput" class="form-control form-control-sm" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="ContactEmail" class="form-label small fw-medium">Contact Email</label>
                <input asp-for="ContactEmail" class="form-control form-control-sm" type="email" />
                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="ContactPhone" class="form-label small fw-medium">Contact Phone</label>
                <input asp-for="ContactPhone" class="form-control form-control-sm" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12">
                <label class="form-label small fw-medium">Pick Location on Map</label>
                <div id="locationMap" style="height:300px; border-radius:8px; border:1px solid #dee2e6; width: 100%;"></div>
                <small class="text-muted d-block mt-1">Click the map to change the pin location and fill in coordinates automatically.</small>
            </div>

            <div class="col-sm-6">
                <label asp-for="Latitude" class="form-label small fw-medium">Latitude</label>
                <input asp-for="Latitude" id="latInput" class="form-control form-control-sm" type="number" min="-90" max="90" step="any" />
                <span asp-validation-for="Latitude" class="text-danger small"></span>
            </div>

            <div class="col-sm-6">
                <label asp-for="Longitude" class="form-label small fw-medium">Longitude</label>
                <input asp-for="Longitude" id="lngInput" class="form-control form-control-sm" type="number" min="-180" max="180" step="any" />
                <span asp-validation-for="Longitude" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-dark btn-sm">Save Changes</button>
    </div>
</form>
