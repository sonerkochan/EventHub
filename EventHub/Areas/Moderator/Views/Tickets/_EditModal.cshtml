@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Admin.AdminTicketEditViewModel

<div class="modal-header">
    <h5 class="modal-title">Edit Ticket #@Model.TicketNumber</h5>
    <button type="button" class="btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="row g-3 mb-3 pb-3 border-bottom">
        <div class="col-md-6">
            <div class="small text-muted">Event</div>
            <div class="fw-medium">@Model.EventName</div>
        </div>
        <div class="col-md-6">
            <div class="small text-muted">Buyer</div>
            <div class="fw-medium">@Model.BuyerDisplay</div>
        </div>
        <div class="col-md-6">
            <div class="small text-muted">Price</div>
            <div class="fw-medium">@Model.Price.ToString("0.00") @Model.Currency</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.HashedCode))
        {
            <div class="col-md-6">
                <div class="small text-muted">Code</div>
                <div class="fw-medium" style="font-family: monospace;">@Model.HashedCode</div>
            </div>
        }
    </div>

    <form id="ticketEditForm">
        <input type="hidden" id="editTicketId" value="@Model.TicketId" />

        <div class="mb-3">
            <label class="form-label small fw-medium">Status</label>
            <select id="editTicketStatus" class="form-control form-control-sm">
                @foreach (var status in Enum.GetValues<TicketStatus>())
                {
                    <option value="@status" selected="@(status == Model.CurrentStatus)">@status</option>
                }
            </select>
            <div class="small text-muted mt-1">
                Changing to/from Purchased or Used will adjust the zone's sold counter automatically.
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-medium">Seat</label>
            @if (Model.AvailableSeats.Count == 0)
            {
                <div class="alert alert-warning small mb-0">No seats available in this event's room.</div>
            }
            else
            {
                <select id="editTicketSeat" class="form-control form-control-sm">
                    @foreach (var seat in Model.AvailableSeats)
                    {
                        var label = $"Seat {seat.SeatNumber}";
                        if (!string.IsNullOrWhiteSpace(seat.ZoneName)) label += $" — {seat.ZoneName}";
                        if (seat.IsCurrent) label += " (current)";
                        <option value="@seat.Id" selected="@seat.IsCurrent">@label</option>
                    }
                </select>
                <div class="small text-muted mt-1">
                    Reassigning to a different zone does not change the ticket's price.
                </div>
            }
        </div>

        <div id="editTicketError" class="alert alert-danger small mb-0" hidden></div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-dark btn-sm" id="editTicketSaveBtn" onclick="submitTicketEdit()">Save changes</button>
</div>
