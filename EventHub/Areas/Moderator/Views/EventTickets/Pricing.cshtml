@using EventHub.Infrastructure.Data.Models
@model EventHub.Core.Models.Admin.EventPricingPageViewModel
@{
    ViewData["Title"] = $"Pricing — {Model.EventName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="fw-semibold mb-0">@Model.EventName</h5>
        <small class="text-muted">Pricing setup &middot; @Model.RoomName</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Events" asp-action="Index"
           class="btn btn-outline-secondary btn-sm">Back to Events</a>
        @if (Model.AllZonesPriced)
        {
            <a asp-action="Manage" asp-route-id="@Model.EventId" class="btn btn-dark btn-sm">
                Open Ticket Manager →
            </a>
        }
        else
        {
            <button class="btn btn-outline-dark btn-sm" disabled title="Set a price for every zone first">
                Open Ticket Manager →
            </button>
        }
    </div>
</div>

@if (Model.Zones.Count == 0)
{
    <div class="alert alert-warning small">
        This event's room has no zones yet. Go back to <a asp-area="Admin" asp-controller="Rooms" asp-action="Layout" asp-route-id="@Model.RoomId">the room layout</a> and create at least one zone before setting prices.
    </div>
}
else
{
    <div class="card border">
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="small">Zone</th>
                        <th class="small">Type</th>
                        <th class="small text-end">Seats</th>
                        <th class="small text-end">Price</th>
                        <th class="small">Currency</th>
                        <th class="small text-end">Available</th>
                        <th class="small text-end">Sold</th>
                        <th class="small text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var z in Model.Zones)
                    {
                        var available = Math.Max(0, z.SeatCount - z.SoldQuantity);
                        <tr data-zone-id="@z.ZoneId" data-tier-id="@(z.TierId?.ToString() ?? string.Empty)">
                            <td class="small fw-medium">@z.ZoneName</td>
                            <td class="small text-muted">@z.ZoneType</td>
                            <td class="small text-end fw-medium">@z.SeatCount</td>
                            <td class="text-end" style="width:130px">
                                <input type="number" step="0.01" min="0"
                                       class="form-control form-control-sm text-end js-price"
                                       value="@(z.Price?.ToString("0.00") ?? "")"
                                       placeholder="—" />
                            </td>
                            <td style="width:100px">
                                <input type="text" maxlength="3"
                                       class="form-control form-control-sm js-currency"
                                       value="@(z.Currency ?? Model.DefaultCurrency)" />
                            </td>
                            <td class="small text-end fw-medium">@available</td>
                            <td class="small text-end">@z.SoldQuantity</td>
                            <td class="text-end" style="width:160px">
                                <button class="btn btn-dark btn-sm js-save">Save</button>
                                @if (z.IsConfigured)
                                {
                                    <button class="btn btn-outline-danger btn-sm js-remove">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-2 mb-0">
        Set a price for every zone before opening the ticket manager. Removing a price deactivates the tier but keeps any existing tickets sold under it.
    </p>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const eventId = '@Model.EventId';
        const setPriceUrl = '@Url.Action("SetPrice")';
        const removePriceUrl = '@Url.Action("RemovePrice")';

        function postJson(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(r => r.json());
        }

        document.querySelectorAll('tr[data-zone-id]').forEach(row => {
            const zoneId = row.dataset.zoneId;
            const priceInput = row.querySelector('.js-price');
            const currencyInput = row.querySelector('.js-currency');
            const saveBtn = row.querySelector('.js-save');
            const removeBtn = row.querySelector('.js-remove');

            saveBtn.addEventListener('click', () => {
                const price = parseFloat(priceInput.value);
                if (isNaN(price) || price < 0) {
                    alert('Enter a valid price (0 or more).');
                    return;
                }
                const currency = (currencyInput.value || 'EUR').trim().toUpperCase();

                saveBtn.disabled = true;
                saveBtn.textContent = 'Saving...';

                postJson(setPriceUrl, {
                    eventId: eventId,
                    zoneId: zoneId,
                    price: price,
                    currency: currency
                }).then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Failed to save price.');
                        saveBtn.disabled = false;
                        saveBtn.textContent = 'Save';
                    }
                }).catch(() => {
                    alert('Failed to save price.');
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'Save';
                });
            });

            if (removeBtn) {
                removeBtn.addEventListener('click', () => {
                    if (!confirm('Remove pricing for this zone? Existing tickets stay intact.')) return;
                    postJson(removePriceUrl, { eventId, zoneId }).then(data => {
                        if (data.success) location.reload();
                    });
                });
            }
        });
    </script>
}
