@using EventHub.Infrastructure.Data.Models
@using EventHub.Localization
@model EventHub.Core.Models.Admin.EventPricingPageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<AdminResource> AdminLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<EnumResource> EnumLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<JsResource> JsLocalizer
@{
    ViewData["Title"] = AdminLocalizer["Admin.Pricing.Title", Model.EventName];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="fw-semibold mb-0">@Model.EventName</h5>
        <small class="text-muted">@AdminLocalizer["Admin.Pricing.Setup", Model.RoomName]</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Moderator" asp-controller="Events" asp-action="Index"
           class="btn btn-outline-secondary btn-sm">@AdminLocalizer["Admin.Events.BackToEvents"]</a>
        @if (Model.AllZonesPriced)
        {
            <a asp-action="Manage" asp-route-id="@Model.EventId" class="btn btn-dark btn-sm">
                @AdminLocalizer["Admin.Pricing.OpenTicketManager"] &rarr;
            </a>
        }
        else
        {
            <button class="btn btn-outline-dark btn-sm" disabled title="@AdminLocalizer["Admin.Pricing.SetEveryZoneFirst"]">
                @AdminLocalizer["Admin.Pricing.OpenTicketManager"] &rarr;
            </button>
        }
    </div>
</div>

@if (Model.Zones.Count == 0)
{
    <div class="alert alert-warning small">
        @AdminLocalizer["Admin.Pricing.NoZones"]
    </div>
}
else
{
    <div class="card border">
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="small">@AdminLocalizer["Admin.Pricing.Zone"]</th>
                        <th class="small">@AdminLocalizer["Admin.Events.Type"]</th>
                        <th class="small text-end">@AdminLocalizer["Admin.Pricing.Seats"]</th>
                        <th class="small text-end">@AdminLocalizer["Admin.Pricing.Price"]</th>
                        <th class="small">@AdminLocalizer["Admin.Pricing.Currency"]</th>
                        <th class="small text-end">@AdminLocalizer["Admin.Pricing.Available"]</th>
                        <th class="small text-end">@AdminLocalizer["Admin.Pricing.Sold"]</th>
                        <th class="small text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var z in Model.Zones)
                    {
                        var available = Math.Max(0, z.SeatCount - z.SoldQuantity);
                        <tr data-zone-id="@z.ZoneId" data-tier-id="@(z.TierId?.ToString() ?? string.Empty)">
                            <td class="small fw-medium">@z.ZoneName</td>
                            <td class="small text-muted">@EnumLocalizer.LocalizeEnum(z.ZoneType)</td>
                            <td class="small text-end fw-medium">@z.SeatCount</td>
                            <td class="text-end" style="width:130px">
                                <input type="number" step="0.01" min="0"
                                       class="form-control form-control-sm text-end js-price"
                                       value="@(z.Price?.ToString("0.00") ?? "")"
                                       placeholder="-" />
                            </td>
                            <td style="width:100px">
                                <input type="text" maxlength="3"
                                       class="form-control form-control-sm js-currency"
                                       value="@(z.Currency ?? Model.DefaultCurrency)" />
                            </td>
                            <td class="small text-end fw-medium">@available</td>
                            <td class="small text-end">@z.SoldQuantity</td>
                            <td class="text-end" style="width:160px">
                                <button class="btn btn-dark btn-sm js-save">@AdminLocalizer["Admin.Common.Save"]</button>
                                @if (z.IsConfigured)
                                {
                                    <button class="btn btn-outline-danger btn-sm js-remove">@AdminLocalizer["Admin.Common.Remove"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-2 mb-0">
        @AdminLocalizer["Admin.Pricing.Help"]
    </p>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const eventId = '@Model.EventId';
        const setPriceUrl = '@Url.Action("SetPrice")';
        const removePriceUrl = '@Url.Action("RemovePrice")';
        const i18n = {
            invalidPrice: '@JavaScriptEncoder.Default.Encode(JsLocalizer["Js.Alert.InvalidPrice"].Value)',
            savePriceFailed: '@JavaScriptEncoder.Default.Encode(JsLocalizer["Js.Alert.SavePriceFailed"].Value)',
            removePricing: '@JavaScriptEncoder.Default.Encode(JsLocalizer["Js.Confirm.RemovePricing"].Value)',
            save: '@JavaScriptEncoder.Default.Encode(AdminLocalizer["Admin.Common.Save"].Value)',
            saving: '@JavaScriptEncoder.Default.Encode(AdminLocalizer["Admin.Common.Saving"].Value)'
        };

        function postJson(url, body) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(r => r.json());
        }

        document.querySelectorAll('tr[data-zone-id]').forEach(row => {
            const zoneId = row.dataset.zoneId;
            const priceInput = row.querySelector('.js-price');
            const currencyInput = row.querySelector('.js-currency');
            const saveBtn = row.querySelector('.js-save');
            const removeBtn = row.querySelector('.js-remove');

            saveBtn.addEventListener('click', () => {
                const price = parseFloat(priceInput.value);
                if (isNaN(price) || price < 0) {
                    alert(i18n.invalidPrice);
                    return;
                }
                const currency = (currencyInput.value || 'EUR').trim().toUpperCase();

                saveBtn.disabled = true;
                saveBtn.textContent = i18n.saving;

                postJson(setPriceUrl, {
                    eventId: eventId,
                    zoneId: zoneId,
                    price: price,
                    currency: currency
                }).then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || i18n.savePriceFailed);
                        saveBtn.disabled = false;
                        saveBtn.textContent = i18n.save;
                    }
                }).catch(() => {
                    alert(i18n.savePriceFailed);
                    saveBtn.disabled = false;
                    saveBtn.textContent = i18n.save;
                });
            });

            if (removeBtn) {
                removeBtn.addEventListener('click', () => {
                    if (!confirm(i18n.removePricing)) return;
                    postJson(removePriceUrl, { eventId, zoneId }).then(data => {
                        if (data.success) location.reload();
                    });
                });
            }
        });
    </script>
}
